# Site build environment (Astro) — copy to .env for local builds.
# PUBLIC_ vars are inlined into the static build at build time.

# GA4 measurement ID (rm 8.4). Leave unset/empty to disable GA4 entirely:
# no <meta name="ga4-id"> is emitted and the consent-gated loader stays inert.
# Set per environment (local .env, CI/deploy build env) — never commit a real ID.
PUBLIC_GA4_ID=
