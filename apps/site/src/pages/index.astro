          <img id="duo-img-3" src={duoImgs['ugreen-5-in-1-usb-c-hub']} alt="UGREEN USB-C hub" style="width:96px;height:76px;object-fit:contain;background:#fff;border:1px solid var(--line);border-radius:12px;padding:6px" />
