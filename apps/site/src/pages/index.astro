        <div style="flex:0 0 258px;scroll-snap-align:start" class="prod">
          <a class="go" href={`/products/${p.slug}`} aria-label={p.name}></a>
          <div class={`ph${getImg(p.imgs) ? ' has-img' : ''}`}>
            {getImg(p.imgs) ? <img src={getImg(p.imgs)} alt={p.name} loading="lazy" /> : <span class="sk">{p.brand}</span>}
