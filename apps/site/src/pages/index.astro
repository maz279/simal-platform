  </div></section>

  <!-- ===== Brand Showcase ===== -->
  <section class="sec"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">Brand showcase</span><h2>Authorized distributor for {brandCount.n} global IT brands</h2></div><a class="btn btn-o" href="/products">Browse by brand →</a></div>
    <div id="brand-rows">
      {brandRows.map((row) => (
        <div style="display:flex;gap:14px;align-items:center;margin-bottom:14px;flex-wrap:wrap">
          <span style="width:172px;font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--slate)">{row[0]}</span>
          <div style="display:flex;gap:9px;flex-wrap:wrap">
            {row[1].map((b) => (
              <a href={`/brands/${slugOf[b] || b.toLowerCase()}`} class="chip" style="font-size:13px;padding:8px 16px;background:#fff;border:1px solid var(--line);text-decoration:none;color:inherit">{b}</a>
            ))}
          </div>
        </div>
      ))}
      <span class="note" style="display:block;margin-top:8px">+ Inno3D and more lines on request — <a href="/contact" style="color:var(--blue);text-decoration:underline">ask the brand desk</a></span>
    </div>
  </div></section>

  <!-- ===== Software Spotlight ===== -->
  <section class="sec"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">Software spotlight</span><h2>Ship your ERP with the people who distribute hardware</h2></div><a class="btn btn-o" href="/software">All software products →</a></div>
    <div class="grid g3">
      <div class="card card-p"><div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--blue-050),#fff);display:grid;place-items:center;font-size:24px;border:1px solid var(--line)">📦</div><span class="badge b-blue" style="margin-top:12px">Flagship ERP</span><h3 style="margin:10px 0 6px">Distribution ERP</h3><p style="color:var(--slate);font-size:13.5px">AI-powered supply-chain &amp; inventory built for distributors — by a partner that runs distribution daily.</p><a class="btn btn-o btn-sm" style="margin-top:14px" href="/software/products/distribution-erp/">Explore the flagship →</a></div>
      <div class="card card-p"><div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--blue-050),#fff);display:grid;place-items:center;font-size:24px;border:1px solid var(--line)">🛒</div><span class="badge b-blue" style="margin-top:12px">Retail</span><h3 style="margin:10px 0 6px">UniPOS</h3><p style="color:var(--slate);font-size:13.5px">Multi-location point-of-sale with real-time inventory — pair with our POS hardware line.</p><a class="btn btn-o btn-sm" style="margin-top:14px" href="/software/#products">See UniPOS detail →</a></div>
      <div class="card card-p"><div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,var(--blue-050),#fff);display:grid;place-items:center;font-size:24px;border:1px solid var(--line)">🧾</div><span class="badge b-blue" style="margin-top:12px">Compliance</span><h3 style="margin:10px 0 6px">UniVAT &amp; e-invoicing</h3><p style="color:var(--slate);font-size:13.5px">NBR-approved VAT automation and UAE Peppol-ready invoicing tooling ahead of the 1 Jan 2027 mandate.</p><a class="btn btn-o btn-sm" style="margin-top:14px" href="/software/#products">See UniVAT detail →</a></div>
    </div>
  </div></section>

  <!-- ===== Proof, Not Promises ===== -->
  <section class="sec" style="background:var(--ink);color:#fff"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow" style="color:var(--yellow)">Proof, not promises</span><h2 style="color:#fff">Trusted by the channel — recognized by the brands</h2></div></div>
    {/* deploy-audit: rm(4.2) (a3859e2) rewrote this grid for CMS awards and dropped the testimonial
       * card, so the CMS testimonials never rendered (the rotator below found no #tst-card), and it
       * left an unbalanced </div>. Testimonial card left, awards column right, as before. */}
    <div class="proof-grid" style="display:grid;grid-template-columns:1.3fr .7fr;gap:24px">
      {testimonialsData.length > 0 && (
        <div class="card card-p" style="background:#12233A;border-color:#1D2E42" id="tst-card" data-testimonials={JSON.stringify(testimonialsData)}>
          <div style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
            <div id="tst-av" style="width:42px;height:42px;border-radius:50%;background:#1D2E42;border:2px solid var(--g3);color:var(--g1);display:grid;place-items:center;font-weight:800;font-size:14px;flex:none">
              {(testimonialsData[0].name || '').split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase()}
            </div>
            <div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span style="color:var(--yellow)" aria-hidden="true">★★★★★</span><span class="sr-only">5 out of 5 stars</span><b id="tst-name">{testimonialsData[0].name} · {testimonialsData[0].role}</b></div></div>
          </div>
          <p style="color:#C6D2E0;font-size:14.5px" id="tst-quote">“{testimonialsData[0].q}”</p>
          <div style="display:flex;gap:12px;align-items:center;margin-top:14px">
            <div style="display:flex;gap:8px;align-items:center" id="tst-dots"></div>
            <button class="tst-pause" id="tst-pause-btn" aria-label="Pause testimonial rotation" title="Pause testimonial rotation" style="min-width:24px;min-height:24px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:4px;cursor:pointer;font-size:10px;padding:2px 6px">❚❚</button>
          </div>
        </div>
      )}
      <div style="display:flex;flex-direction:column;gap:14px">
        {awards.map((a: any) => (
          <div class="card card-p" style="background:#12233A;border-color:#1D2E42;display:flex;gap:14px;align-items:center"><div style="width:46px;height:46px;border-radius:12px;background:var(--grad-gold-btn);display:grid;place-items:center;font-size:21px;flex:none">🏆</div><div><span class="badge b-red">Award {a.year}</span><p style="color:#fff;font-weight:700;margin-top:6px;font-size:13.5px">{a.title}</p></div></div>
        ))}
      </div>
    </div>
  </div></section>

  <!-- ===== Tech Talk Latest Insights ===== -->
  <section class="sec" style="background:#fff;border-top:1px solid var(--line)"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">Tech Talk by Simal</span><h2>Latest insights</h2></div><a class="btn btn-o" href="/insights">Visit Insights →</a></div>
    <div class="grid g3" id="home-insights">
      {insights.map((a: any) => (
        <div class="card" style="overflow:hidden">
          {a.cover ? (
            <div style="height:120px;background:#fff;display:grid;place-items:center;border-bottom:1px solid var(--line)">
              <img src={a.cover} alt="" style="max-height:104px;max-width:86%;object-fit:contain" />
            </div>
          ) : null}
          <div class="card-p" style="padding:14px 16px">
            <span class="badge b-line">{a.cat} · {a.mins} MIN</span>
            <h4 style="font-size:15px;margin:9px 0 6px"><a href={`/insights/${a.slug}`} style="color:inherit;text-decoration:none">{a.t}</a></h4>
            <p style="font-size:12.5px;color:var(--slate)">{a.x}</p>
            <a href={`/insights/${a.slug}`} style="font-size:12.5px;font-weight:700;color:var(--blue)">Read the article →</a>
          </div>
        </div>
      ))}
    </div>
  </div></section>
</BaseLayout>

<style is:global>
