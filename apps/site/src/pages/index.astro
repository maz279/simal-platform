---
// index.astro — Home page. VISUAL CONTRACT: 100% Parity with Prototype index.html + home.js.
// Preserves Redington-grade Hero v2 carousel + below-hero RFQ card, credibility strip,
// "One company, two engines" split cards, Featured Products horizontal scroll strip,
// 4-row Brand Showcase, Software Spotlight, "Proof, not promises" Testimonials & Awards,
// and Tech Talk Latest Insights.
import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../lib/db';

const slides = await db`SELECT idx, kick, headline, sub, cta_label, cta_href, photo_slug, motif, bg FROM hero_slides WHERE active = true ORDER BY idx`;
const [total] = await db`SELECT count(*)::int AS n FROM products`;
const [brandCount] = await db`SELECT count(*)::int AS n FROM brands WHERE slug != 'other'`;
const [countersRow] = await db`SELECT payload FROM content_blocks WHERE entity='site' AND entity_id='counters' AND lang='en'`;
const DEFAULT_COUNTERS = { brands: 22, skus: 78, years: 24, since: 2002 };
const counters: any = { ...DEFAULT_COUNTERS, ...(countersRow?.payload || {}) };
const [awardsRow] = await db`SELECT payload FROM content_blocks WHERE entity='site' AND entity_id='awards' AND lang='en'`;
const DEFAULT_AWARDS = [{ year: '2025', title: 'Hikvision — Best Distributor Partner', issuer: 'Hikvision' }, { year: '2025', title: 'TeamGroup — Best Partner 2025', issuer: 'TeamGroup' }];
const awards: any[] = Array.isArray(awardsRow?.payload) ? awardsRow.payload : DEFAULT_AWARDS;
/* rm(6.1-2/9.1-1, PUB-8): CMS-stored hero slide text may carry {years} / {brands} / {skus}
 * tokens (seed slide 5: "… · {years} Years in MEA"), so a site/counters edit reaches the hero. */
const withFacts = (t: unknown) => String(t ?? '').replace(/\{years\}/g, String(counters.years))
  .replace(/\{brands\}/g, String(brandCount.n)).replace(/\{skus\}/g, String(total.n));

const getImg = (imgs: unknown): string => {
  const v = Array.isArray(imgs) ? imgs[0] : (typeof imgs === 'string' ? JSON.parse(imgs)[0] : '');
  return v && !v.startsWith('/') ? '/' + v : v;
};

/* photos for hero slides that carry one */
const photoRows = await db`SELECT slug, imgs FROM products WHERE slug = ANY(${slides.map((s: { photo_slug: string | null }) => s.photo_slug).filter(Boolean)})`;
const photoOf: Record<string, string> = {};
for (const r of photoRows) photoOf[r.slug] = getImg(r.imgs);

const SLIDE_METADATA = [
  {
    tab: 'Gen5 NVMe',
    accent: '#00D2FF',
    badges: ['⚡ 14,500 MB/s Read', 'Micron 232-Layer 3D TLC', 'PCIe Gen5 ×4'],
    calloutVal: '14.5 GB/s',
    calloutLbl: 'Peak Read Speed'
  },
  {
    tab: 'DDR5 Memory',
    accent: '#38BDF8',
    badges: ['⚡ Up to 6000 MT/s', 'DDR5 Pro & ECC RDIMM', 'Lifetime Warranty'],
    calloutVal: '6000 MT/s',
    calloutLbl: 'Low Latency CL36'
  },
  {
    tab: 'Extreme SSD',
    accent: '#F59E0B',
    badges: ['⚡ 2,100 MB/s Read', 'Anodized Aluminum IP55', 'USB 3.2 Gen 2×2'],
    calloutVal: '2,100 MB/s',
    calloutLbl: 'Fastest Portable SSD'
  },
  {
    tab: 'Pro Gen4 SSD',
    accent: '#10B981',
    badges: ['⚡ 7,400 MB/s Read', 'Low-Profile Heatsink', 'Micron 232-Layer NAND'],
    calloutVal: '7,400 MB/s',
    calloutLbl: 'Pro Gen4 Speed'
  },
  {
    tab: 'Channel Hub',
    accent: '#EAB308',
    badges: ['🏢 ' + brandCount.n + ' Global Leaders', 'Dubai JAFZA Bonded Hub', 'Same-Day Dispatch'],
    calloutVal: `${counters.years} Years`,
    calloutLbl: 'Authorized MEA Hub'
  }
];

// rm(3.1-1) / F-2026-N10: hero CTA hrefs are CMS-stored — sanitize at the source
  // (same policy as BaseLayout's announcement safeHref) so a stored javascript:/data:/vbscript:
  // URL can never reach the client stage renderer.
  const safeHeroHref = (raw?: string) => {
    const clean = String(raw || '').trim();
    if (/^(?:javascript|data|vbscript):/i.test(clean)) return '#';
    return clean || '#';
  };
  /* rm(6.3-2)/F-2026-N16: hero_slides.bg is now RENDERED, but only after this strict
   * whitelist — a relative image path becomes a url(...) cover background; a hex color
   * or a simple linear/radial gradient passes as-is; anything else (absolute URLs,
   * javascript:, "image asset path" prose) falls back to the canned BG gradient. */
  const bgOf = (v: unknown): string => {
    const s = String(v || '').trim();
    if (/^\/[\w\/.-]+\.(?:jpe?g|png|webp|avif)$/i.test(s)) return `url("${s}") center/cover no-repeat`;
    return /^(?:#[0-9a-f]{3,8}|(?:linear|radial)-gradient\([#\w\s.,%()-]+\))$/i.test(s) ? s : '';
  };
  const heroData = slides.map((s: any, i: number) => {
  const meta = SLIDE_METADATA[i] || {
    tab: `0${i + 1}`,
    accent: '#00D2FF',
    badges: ['Authorized Stock', 'Local Warranty'],
    calloutVal: '100%',
    calloutLbl: 'Genuine Stock'
  };
  return {
    idx: s.idx,
    kick: withFacts(s.kick),
    h: withFacts(s.headline),
    s: withFacts(s.sub),
    cta: s.cta_label,
    href: safeHeroHref(s.cta_href),
    motif: s.motif || '',
    bg: s.bg || '',
    bgCss: bgOf(s.bg),
    photo: s.photo_slug ? (photoOf[s.photo_slug] || '') : '',
    ...meta
  };
});

/* rm(9.1-3): hero slide decoration constants — single source in the
 * frontmatter. The island used to re-render the whole stage from these
 * (discarding the server render and forcing a second layout); the server
 * now emits the final markup and the island only wires the controls. */
const BG_GRADIENTS = [
  'radial-gradient(ellipse 70% 85% at 75% 50%, rgba(0, 114, 206, 0.38) 0%, transparent 70%), radial-gradient(circle at 18% 25%, rgba(14, 42, 77, 0.85) 0%, transparent 60%), linear-gradient(135deg, #040A14 0%, #07172E 50%, #0B2240 100%)',
  'radial-gradient(ellipse 70% 85% at 75% 50%, rgba(30, 90, 170, 0.40) 0%, transparent 70%), radial-gradient(circle at 18% 30%, rgba(20, 48, 85, 0.75) 0%, transparent 60%), linear-gradient(135deg, #050B16 0%, #091932 50%, #0E294D 100%)',
  'radial-gradient(ellipse 70% 85% at 75% 50%, rgba(214, 168, 68, 0.32) 0%, transparent 70%), radial-gradient(circle at 20% 30%, rgba(45, 30, 52, 0.75) 0%, transparent 60%), linear-gradient(135deg, #0B0B14 0%, #171526 50%, #241E30 100%)',
  'radial-gradient(ellipse 70% 85% at 75% 50%, rgba(13, 148, 136, 0.35) 0%, transparent 70%), radial-gradient(circle at 18% 28%, rgba(8, 52, 44, 0.75) 0%, transparent 60%), linear-gradient(135deg, #030E0B 0%, #06221B 50%, #0A362B 100%)',
  'radial-gradient(ellipse 70% 85% at 75% 50%, rgba(234, 179, 8, 0.30) 0%, transparent 70%), radial-gradient(circle at 16% 25%, rgba(18, 38, 70, 0.85) 0%, transparent 60%), linear-gradient(135deg, #060D1A 0%, #0C1E38 50%, #162E52 100%)',
];
const GLOW_COLORS = [
  'rgba(0, 210, 255, 0.45)',
  'rgba(56, 189, 248, 0.45)',
  'rgba(245, 158, 11, 0.42)',
  'rgba(16, 185, 129, 0.42)',
  'rgba(234, 179, 8, 0.42)',
];
const MOTIF_STYLES: Record<string, string> = {
  grid: "background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='72' height='72'><path d='M72 0H0V72' fill='none' stroke='rgba(255,255,255,0.08)' stroke-width='1'/></svg>\")",
  arcs: "background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='420' height='420'><g fill='none' stroke='rgba(255,255,255,0.07)' stroke-width='1'><circle cx='210' cy='210' r='90'/><circle cx='210' cy='210' r='140'/><circle cx='210' cy='210' r='190'/></g></svg>\");background-size:420px;background-position:82% 120%",
  rings: "background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='520' height='260'><g fill='none' stroke='rgba(255,255,255,0.07)' stroke-width='1'><circle cx='130' cy='130' r='40'/><circle cx='130' cy='130' r='70'/><circle cx='130' cy='130' r='100'/><circle cx='390' cy='130' r='55'/><circle cx='390' cy='130' r='95'/></g></svg>\");background-size:520px;background-position:78% 82%",
  dots: "background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='46' height='46'><circle cx='4' cy='4' r='1.6' fill='rgba(233,216,170,0.18)'/><circle cx='27' cy='4' r='1.6' fill='rgba(233,216,170,0.10)'/><circle cx='4' cy='27' r='1.6' fill='rgba(233,216,170,0.10)'/><circle cx='27' cy='27' r='1.6' fill='rgba(233,216,170,0.18)'/></svg>\");background-size:46px;background-position:80% 30%",
};

/* duo business card thumbnails */
const duoSlugs = ['crucial-t705-ssd-2', 'koorui-27-inch-gaming-monitor', 'ugreen-5-in-1-usb-c-hub'];
const duoRows = await db`SELECT slug, imgs FROM products WHERE slug = ANY(${duoSlugs})`;
const duoImgs: Record<string, string> = {};
for (const r of duoRows) duoImgs[r.slug] = getImg(r.imgs);

/* featured 12 products strip — dynamic via CMS content block with safe fallback */
const DEFAULT_FEATURED_SLUGS = [
  'crucial-t500-heatsink',
  'ugreen-5-in-1-usb-c-hub',
  'koorui-27-inch-gaming-monitor',
  'gtx1030-2gb-gddr5-64-bit-hdmi-dvi-vga',
  'arktek-rtx3060-led-ga104-150-a1-3584sp-gddr6-12gb-13201777-12gbps_6b2aaad2',
  '1672',
  'samsung-t7-shield-portable-ssd-1tb',
  'dell-15-laptop-14th-gen-intel-core-3',
  'crucial-ddr4-pro-memory',
  'aiwa-22-flat-slim-monitor-75hz-fhd-hdmivga-56x36x11-cm-black',
  'kingston-xs1000-1tb-portable-ssd-red',
  'crucial-t705-ssd-2'
];
const [featuredBlockRow] = await db`SELECT payload FROM content_blocks WHERE entity = 'site' AND entity_id = 'featured-products' AND lang = 'en'`;
const rawSlugs = featuredBlockRow?.payload?.slugs;
const featuredSlugs: string[] = Array.isArray(rawSlugs) && rawSlugs.length ? rawSlugs : DEFAULT_FEATURED_SLUGS;

const featuredRows = await db`SELECT slug, name, brand, short, imgs FROM products WHERE slug = ANY(${featuredSlugs})`;
const featuredMap = new Map(featuredRows.map((r: any) => [r.slug, r]));
const featuredProducts = featuredSlugs.map((s: string) => featuredMap.get(s)).filter(Boolean);

/* brand rows configuration matching Prototype/data/content.js */
const brandRows = [
  ['Storage & Memory', ['Crucial', 'Hikvision', 'Samsung', 'Kingston', 'SanDisk', 'WD', 'TeamGroup', 'Toshiba']],
  ['Graphics & Components', ['Arktek', 'MSI', 'Zotac', 'PNY']],
  ['Computing', ['Dell', 'HP', 'Lenovo']],
  ['Accessories & Displays', ['UGREEN', 'Honeywell', 'KOORUI', 'Aiwa', 'Nearity']]
];
const slugOf: Record<string, string> = {
  Crucial: 'crucial', Hikvision: 'hikvision', Samsung: 'samsung', Kingston: 'kingston',
  SanDisk: 'sandisk', WD: 'wd', TeamGroup: 'teamgroup', Toshiba: 'toshiba',
  Arktek: 'arktek', MSI: 'msi', Zotac: 'zotac', PNY: 'pny',
  Dell: 'dell', HP: 'hp', Lenovo: 'lenovo', UGREEN: 'ugreen',
  Honeywell: 'honeywell', KOORUI: 'koorui', Aiwa: 'aiwa', Nearity: 'nearity'
};

/* testimonials */
const testimonialsRows = await db`SELECT name, role, company, quote FROM testimonials WHERE active = true ORDER BY id`;
const testimonialsData = testimonialsRows.map((t: any) => ({
  name: t.name,
  role: t.company ? `${t.role}, ${t.company}` : t.role,
  q: t.quote
}));

/* insights (top 3) with covers */
const insightBlocks = await db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'insight' AND lang = 'en' ORDER BY payload->>'at' DESC NULLS LAST LIMIT 3`;
const COVERS: Record<string, string> = {
  'top-ssds-for-resellers-2025': duoImgs['crucial-t705-ssd-2'] || '',
  'crucial-p510-launch': duoImgs['crucial-t705-ssd-2'] || '',
  'ugreen-authorized-distributor-in-uae': duoImgs['ugreen-5-in-1-usb-c-hub'] || ''
};
const insights = insightBlocks.map(({ entity_id, payload }: any) => {
  const p = typeof payload === 'string' ? JSON.parse(payload) : payload;
  return {
    slug: entity_id,
    t: p.t || entity_id,
    cat: p.cat || 'MARKET INTELLIGENCE',
    mins: p.mins || 5,
    x: p.x || '',
    cover: COVERS[entity_id] || ''
  };
});
---

<BaseLayout title="Simal Technologies ME — IT Distribution & Software Services, Dubai">
  <!-- ===== hero semiconductor showcase: framed stage reduced 1 inch horizontally, 5 memory slides ===== -->
  <section class="hero-semiconductor" id="hero5-sec">
    <div class="hero-wrap">
      <div id="hero5-stage" role="region" aria-roledescription="carousel" aria-label="Featured memory and storage products" data-slides={JSON.stringify(heroData)}>
        {heroData.map((sl: any, i: number) => (
          <div class={`h5-slide${i === 0 ? ' on' : ''}`} data-i={i} role="tabpanel" aria-roledescription="slide" aria-label={`Slide ${i + 1} of ${heroData.length}: ${sl.h}`} style={`background:${sl.bgCss || BG_GRADIENTS[i % BG_GRADIENTS.length]};--tag-accent:${sl.accent || '#00D2FF'}`}>
            {sl.motif && MOTIF_STYLES[sl.motif] ? <div class="h5-motif" style={MOTIF_STYLES[sl.motif]}></div> : null}<div class="h5-grain"></div><div class="h5-vignette"></div>
            <div class="h5-copy">
              <div class="h5-tag">
                <span class="h5-tag-pulse"></span>
                <span>{sl.kick}</span>
              </div>
              {i === 0 ? (
                <h1 class="h5-head">{sl.h}</h1>
              ) : (
                <h2 class="h5-head">{sl.h}</h2>
              )}
              <p class="h5-desc">{sl.s}</p>
              {sl.badges && sl.badges.length > 0 && (
                <div class="h5-specs">
                  {sl.badges.map((b: string) => <span class="h5-spec-pill">{b}</span>)}
                </div>
              )}
              <div class="h5-actions">
                <a class="btn btn-gold btn-lg" href={sl.href}>{sl.cta} →</a>
                <a class="btn btn-o btn-lg h5-btn-rfq" href="/rfq" aria-label="Request channel quote">Request Channel Quote</a>
              </div>
            </div>
            {sl.photo && (
              <div class="h5-visual" aria-hidden="true" style={`--slide-glow:${GLOW_COLORS[i % GLOW_COLORS.length]};--slide-accent:${sl.accent || '#00D2FF'}`}>
                <div class="h5-glow"></div>
                <div class="h5-prod-frame">
                  <img class="h5-prod-img" src={sl.photo} alt={sl.h} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
                  <div class="h5-card-float">
                    <div class="h5-card-val"><span>⚡</span> {sl.calloutVal}</div>
                    <div class="h5-card-lbl">{sl.calloutLbl}</div>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
        <button class="h5-arrow l" aria-label="Previous slide" title="Previous slide">‹</button>
        <button class="h5-arrow r" aria-label="Next slide" title="Next slide">›</button>
        <div class="h5-bar">
          <div class="h5-tabs" role="tablist" aria-label="Featured slides">
            {heroData.map((sl: any, i: number) => (
              <button class={`h5-tab${i === 0 ? ' on' : ''}`} data-i={i} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`0${i + 1} ${sl.tab || 'Overview'}`}>
                <span class="h5-tab-num">0{i + 1}</span>
                <span>{sl.tab || 'Overview'}</span>
              </button>
            ))}
          </div>
          <button class="h5-pause" id="h5-pause-btn" aria-label="Pause slide rotation" title="Pause slide rotation">❚❚</button>
          <div class="h5-count" aria-live="polite">1 / {heroData.length}</div>
        </div>
        <div class="h5-prog"><i aria-hidden="true"></i></div>
      </div>
      <!-- ===== Executive B2B Action Consoles ===== -->
      <div id="hero5-below">
        <!-- Console Left: Channel Procurement & Direct SKU Hub -->
        <div class="hero-card hero-procure-card">
          <div class="h-card-head">
            <div class="h-card-title">
              <span class="h-card-icon">🔍</span>
              <div>
                <h3>Channel Procurement &amp; SKU Lookup</h3>
                <p class="h-card-sub">Instant catalog access for authorized resellers &amp; system builders</p>
              </div>
            </div>
            <span class="h-live-badge"><span class="h-pulse-dot"></span> Dubai Hub Live</span>
          </div>

          <div class="hero-search-box">
            <div class="hero-input-wrap">
              <svg class="h-search-ico" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
              <input id="hq" type="search" placeholder="Search by MPN, SKU, brand, or model (e.g. T705, DDR5, UGREEN)..." aria-label="Search products, brands, SKUs" />
            </div>
            <button class="btn btn-gold h-search-btn" id="hqb">Search Catalog</button>
          </div>

          <div class="hero-quick-filters">
            <span class="h-filter-lbl">Quick Jumps:</span>
            <div class="h-chips-row">
              <a href="/products?cat=storage" class="h-qchip"><span>⚡</span> Gen5 NVMe</a>
              <a href="/products?cat=memory" class="h-qchip"><span>💾</span> DDR5 Memory</a>
              <a href="/products?q=ssd" class="h-qchip"><span>💽</span> Enterprise SSD</a>
              <a href="/products?cat=monitors" class="h-qchip"><span>🖥️</span> Displays</a>
              <a href="/products?cat=accessories" class="h-qchip"><span>🔌</span> USB-C Docks</a>
            </div>
          </div>

          <div class="hero-pillars-grid">
            <div class="h-pillar-item">
              <span class="h-p-icon">🛡️</span>
              <div>
                <strong>100% Genuine Serialized</strong>
                <span>Official local warranty &amp; batch tracing</span>
              </div>
            </div>
            <div class="h-pillar-item">
              <span class="h-p-icon">🚚</span>
              <div>
                <strong>Dubai JAFZA Hub</strong>
                <span>Same-day UAE &amp; rapid GCC freight</span>
              </div>
            </div>
            <div class="h-pillar-item">
              <span class="h-p-icon">📋</span>
              <div>
                <strong>Peppol &amp; FTA Tax Ready</strong>
                <span>Instant compliant digital e-invoicing</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Console Right: Active B2B RFQ Quotation Console -->
        <div class="hero-card hero-rfq-card">
          <div class="h-card-head">
            <div class="h-card-title">
              <span class="h-card-icon">📦</span>
              <div>
                <h3>B2B RFQ Basket &amp; Rapid Quote</h3>
                <p class="h-card-sub">Tiered wholesale channel pricing with guaranteed SLA</p>
              </div>
            </div>
            <span class="badge b-ok" id="mini-count">0 items</span>
          </div>

          <div class="h-basket-container" id="mini-basket"></div>

          <a class="btn h-rfq-submit-btn" href="/rfq">
            <span>Submit RFQ for Channel Pricing</span>
            <svg viewBox="0 0 20 20" fill="currentColor" style="width:18px;height:18px" aria-hidden="true"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </a>

          <div class="h-rfq-footer">
            <span class="h-rfq-pill">⚡ Guaranteed response &le; 1 business day</span>
            <span class="h-rfq-note">No upfront payment · Dedicated account manager assigned</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Executive Credibility & Scale Metric Bar ===== -->
  <div class="cred-executive" id="cred-sec">
    <div class="cred-wrap" id="cred-strip">
      <div class="cred-tile">
        <div class="cred-icon-box">📅</div>
        <div class="cred-content">
          <div class="cred-num-row">
            <span class="cred-num">{counters.years}</span>
            <span class="cred-unit">Years</span>
          </div>
          <span class="cred-label">Regional Channel Leadership</span>
          <span class="cred-sub">Established Dubai, 2002</span>
        </div>
      </div>

      <div class="cred-tile">
        <div class="cred-icon-box">🏢</div>
        <div class="cred-content">
          <div class="cred-num-row">
            <span class="cred-num">{brandCount.n}</span>
            <span class="cred-unit">Brands</span>
          </div>
          <span class="cred-label">Direct Authorized Lines</span>
          <span class="cred-sub">Tier-1 Micron, Crucial, UGREEN &amp; more</span>
        </div>
      </div>

      <div class="cred-tile">
        <div class="cred-icon-box">📦</div>
        <div class="cred-content">
          <div class="cred-num-row">
            <span class="cred-num">{total.n}</span>
            <span class="cred-unit">SKUs</span>
          </div>
          <span class="cred-label">Stocked &amp; Bonded Inventory</span>
          <span class="cred-sub">JAFZA duty-free warehouse</span>
        </div>
      </div>

      <div class="cred-tile">
        <div class="cred-icon-box">💻</div>
        <div class="cred-content">
          <div class="cred-num-row">
            <span class="cred-num">40<span class="cred-plus">+</span></span>
            <span class="cred-unit">Engineers</span>
          </div>
          <span class="cred-label">Software &amp; System Architects</span>
          <span class="cred-sub">Custom ERP, AI &amp; Regional Support</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== One Company, Two Engines ===== -->
  <section class="sec"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">One company, two engines</span><h2>Distribute with us. Build with us.</h2>
    <p>Hardware at wholesale scale — and, new for 2026, enterprise software &amp; AI delivered by Simal + Unisoft Systems Ltd.</p></div></div>
    <div class="split">
      <div class="card card-p" style="border-top:4px solid var(--blue)">
        <span class="badge b-blue">Distribution · Hardware</span>
