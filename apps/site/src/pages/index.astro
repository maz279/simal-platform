          <div class="pb">
            <span class="cat">{p.brand}</span>
            <h4 style="font-size:14px;line-height:1.3;margin:6px 0;height:38px;overflow:hidden">{p.name}</h4>
            <div class="meta" style="height:34px;overflow:hidden;font-size:12px;color:var(--slate)">{(p.short || '').slice(0, 60)}…</div>
            <div class="pr" style="margin-top:10px;display:flex;justify-content:space-between;align-items:center"><span class="price" style="font-size:12px">RFQ · channel pricing</span><span class="vd" style="font-size:12px">View details →</span></div>
          </div>
        </div>
      ))}
