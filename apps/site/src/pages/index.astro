</style>

<script>
  /* Hero island — 5 top-class memory & semiconductor slides */
  const stage = document.getElementById('hero5-stage') as HTMLElement | null;

  if (stage) {
    const slides: any[] = JSON.parse(stage.dataset.slides || '[]');

    /* rm(9.1-3): no client re-render — the server emits the final slide
     * markup (motif, background, glow included); wiring below binds to it. */
    const els = stage.querySelectorAll<HTMLElement>('.h5-slide');
    const tabs = stage.querySelectorAll<HTMLElement>('.h5-tab');
    const count = stage.querySelector<HTMLElement>('.h5-count');
    const prog = stage.querySelector<HTMLElement>('.h5-prog i')!;
    const MS = 6500;
    let cur = 0, timer: ReturnType<typeof setInterval> | null = null;

    // Check for explicit slide query param (e.g. ?slide=2) for testing/direct navigation
    const urlParams = new URLSearchParams(window.location.search);
    const startSlideParam = urlParams.get('slide');
    if (startSlideParam !== null) {
      const parsed = parseInt(startSlideParam, 10);
      if (!isNaN(parsed) && parsed >= 0 && parsed < slides.length) {
        cur = parsed;
      }
    }

    function paint(i: number) {
      cur = (i + slides.length) % slides.length;
      els.forEach((el, j) => {
        const on = j === cur;
        el.classList.toggle('on', on);
        el.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      tabs.forEach((t, j) => {
        const on = j === cur;
        t.classList.toggle('on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (count) count.textContent = `${cur + 1} / ${slides.length}`;
      prog.style.transition = 'none';
      prog.style.width = '0';
      requestAnimationFrame(() => {
        prog.style.transition = `width ${MS}ms linear`;
        prog.style.width = '100%';
      });
    }

    const pauseBtn = stage.querySelector('#h5-pause-btn') as HTMLButtonElement | null;
    let isPaused = false;
    function updatePauseBtn() {
      if (!pauseBtn) return;
      pauseBtn.setAttribute('aria-label', isPaused ? 'Play slide rotation' : 'Pause slide rotation');
      pauseBtn.setAttribute('title', isPaused ? 'Play slide rotation' : 'Pause slide rotation');
      pauseBtn.textContent = isPaused ? '►' : '❚❚';
    }
    pauseBtn?.addEventListener('click', () => {
      isPaused = !isPaused;
      if (isPaused) {
        stop();
      } else {
        play();
      }
      updatePauseBtn();
    });

    (window as any).heroGotoSlide = (idx: number) => {
      stop();
      paint(idx);
    };

    function play() {
      stop();
      if (!isPaused && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = setInterval(() => paint(cur + 1), MS);
      }
      paint(cur);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    tabs.forEach(t => t.addEventListener('click', () => {
      paint(+(t.dataset.i || 0));
      play();
    }));

    stage.querySelector('.h5-arrow.l')?.addEventListener('click', () => { paint(cur - 1); play(); });
    stage.querySelector('.h5-arrow.r')?.addEventListener('click', () => { paint(cur + 1); play(); });

    // Keyboard navigation (ArrowLeft, ArrowRight)
    stage.setAttribute('tabindex', '0');
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        paint(cur - 1);
        play();
      } else if (e.key === 'ArrowRight') {
        paint(cur + 1);
        play();
      }
    });

    // Pause on hover or focus for a11y compliance
    stage.addEventListener('mouseenter', stop);
    stage.addEventListener('mouseleave', play);
    stage.addEventListener('focusin', stop);
    stage.addEventListener('focusout', play);

    // Touch swipe gestures
    let sx = 0;
    stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 40) {
        paint(cur + (dx < 0 ? 1 : -1));
        play();
      }
    }, { passive: true });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      isPaused = true;
      updatePauseBtn();
      paint(0);
    } else {
      play();
    }
  }

  /* mini basket — the real server basket (ADR-2: cookie-carried) */
  async function renderMini() {
    const box = document.getElementById('mini-basket');
    const mc = document.getElementById('mini-count');
    try {
      let b: any[] = [];
      let totalQty = 0;
      try {
        const j = await fetch('/api/rfq-basket').then(r => r.json());
        if (j && Array.isArray(j.basket) && j.basket.length > 0) {
          b = j.basket;
          totalQty = j.totalQty ?? 0;
        }
      } catch {}

      if (b.length === 0) {
        if (mc) mc.textContent = '0 items';
        if (!box) return;
        box.innerHTML = `
          <div class="row" style="color:var(--muted-on-dark, #CBD5E1);font-size:13px"><span>Your RFQ basket is empty</span><b>0</b></div>
          <div class="row"><span>Response SLA</span><b>≤ 1 business day</b></div>
          <div style="margin-top:10px;text-align:center"><a href="/products" class="btn btn-sm btn-o" style="width:100%">Browse catalog to add items →</a></div>
        `;
        return;
      }

      if (mc) mc.textContent = `${totalQty} item${totalQty === 1 ? '' : 's'}`;
      if (!box) return;
      // rm(3.1-2) / F-2026-N10: product names/imgs are DB-controlled — escape every interpolation.
      const escMini = (v: any) => String(v ?? '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      box.innerHTML = b.slice(0, 4).map((i: any) => {
        const th = i.img ? `<img src="${escMini(i.img)}" alt="" style="width:42px;height:34px;object-fit:contain;background:rgba(255,255,255,.9);border-radius:8px;padding:2px;flex:none">` : '';
        return `<div class="row">${th}<span style="flex:1;padding-left:${th ? 10 : 0}px">${escMini(String(i.name || i.slug).slice(0, 44))}</span><b>× ${escMini(i.qty)}</b></div>`;
      }).join('') +
      (b.length > 4 ? `<div class="row"><span>+ ${b.length - 4} more…</span><b></b></div>` : '') +
      '<div class="row"><span>Response SLA</span><b>≤ 1 business day</b></div>';
    } catch {}
  }
  renderMini();

  /* Testimonials Rotator */
  const tstCard = document.getElementById('tst-card');
  if (tstCard) {
    const tsts = JSON.parse(tstCard.dataset.testimonials || '[]');
    if (tsts.length > 0) {
      let ti = 0;
      const tstName = document.getElementById('tst-name');
      const tstQuote = document.getElementById('tst-quote');
      const tstAv = document.getElementById('tst-av');
      const tstDots = document.getElementById('tst-dots');

      function showT(idx: number) {
        ti = (idx + tsts.length) % tsts.length;
        const item = tsts[ti];
        if (tstName) tstName.textContent = `${item.name} · ${item.role}`;
        if (tstQuote) tstQuote.textContent = `“${item.q}”`;
        if (tstAv) {
          const initials = (item.name || '').split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
          tstAv.textContent = initials || 'ST';
        }
        if (tstDots) {
          tstDots.innerHTML = tsts.map((_: any, j: number) =>
            `<button style="min-width:24px;min-height:24px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;padding:0;cursor:pointer" data-i="${j}" aria-label="Testimonial ${j+1}"><span style="width:9px;height:9px;border-radius:50%;display:inline-block;background:${j === ti ? 'var(--g2)' : '#2C4159'}"></span></button>`
          ).join('');
          tstDots.querySelectorAll('button').forEach((b: HTMLElement) => {
            b.addEventListener('click', () => { showT(+(b.dataset.i || 0)); });
          });
        }
      }
      showT(0);
      let isTstPaused = false;
      let tstTimer: ReturnType<typeof setInterval> | null = null;
      function startTstTimer() {
        if (tstTimer) clearInterval(tstTimer);
        if (!isTstPaused && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          tstTimer = setInterval(() => showT(ti + 1), 7000);
        }
      }
      function stopTstTimer() {
        if (tstTimer) { clearInterval(tstTimer); tstTimer = null; }
      }
      startTstTimer();

      const tstPauseBtn = document.getElementById('tst-pause-btn') as HTMLButtonElement | null;
      function updateTstPauseBtn() {
        if (!tstPauseBtn) return;
        tstPauseBtn.setAttribute('aria-label', isTstPaused ? 'Play testimonial rotation' : 'Pause testimonial rotation');
        tstPauseBtn.setAttribute('title', isTstPaused ? 'Play testimonial rotation' : 'Pause testimonial rotation');
        tstPauseBtn.textContent = isTstPaused ? '►' : '❚❚';
      }
      tstPauseBtn?.addEventListener('click', () => {
        isTstPaused = !isTstPaused;
        if (isTstPaused) stopTstTimer();
        else startTstTimer();
        updateTstPauseBtn();
      });
      tstCard.addEventListener('mouseenter', stopTstTimer);
      tstCard.addEventListener('mouseleave', () => { if (!isTstPaused) startTstTimer(); });
      tstCard.addEventListener('focusin', stopTstTimer);
      tstCard.addEventListener('focusout', () => { if (!isTstPaused) startTstTimer(); });
    }
  }

  /* hero search (prototype #hq) — routes to the catalog with the query */
  const hq = document.getElementById('hq') as HTMLInputElement | null;
  const goHero = () => { if (hq && hq.value.trim()) location.href = '/search/?q=' + encodeURIComponent(hq.value.trim()); };
  document.getElementById('hqb')?.addEventListener('click', goHero);
  hq?.addEventListener('keydown', (e) => { if (e.key === 'Enter') goHero(); });
</script>
