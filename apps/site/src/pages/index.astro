    visibility: hidden;
    transition: opacity .75s cubic-bezier(0.16, 1, 0.3, 1), visibility .75s;
    pointer-events: none;
    display: grid;
    grid-template-columns: 1.16fr 0.84fr;
    align-items: center;
    padding: 0 76px; /* Generous 76px horizontal padding ensures arrows never overlap copy */
    overflow: hidden;
