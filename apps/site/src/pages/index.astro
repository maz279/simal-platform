  .h5-slide.on .h5-tag { animation: h5rise .6s .04s cubic-bezier(.16, 1, .3, 1) both; }
  .h5-slide.on .h5-head { animation: h5rise .7s .12s cubic-bezier(.16, 1, .3, 1) both; }
  .h5-slide.on .h5-desc { animation: h5rise .7s .20s cubic-bezier(.16, 1, .3, 1) both; }
  .h5-slide.on .h5-specs { animation: h5rise .7s .28s cubic-bezier(.16, 1, .3, 1) both; }
  .h5-slide.on .h5-actions { animation: h5rise .7s .36s cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes h5rise {
