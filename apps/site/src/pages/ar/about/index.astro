---
// apps/site/src/pages/ar/about/index.astro — Arabic About Twin Page (SEO-1)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';
import { siteFacts } from '../../../lib/facts';
import { arSiteBlock, factText } from '../../../lib/blocks';

const [{ n: productCount }] = await db`SELECT count(*) AS n FROM products`;
// rm(6.1-2/9.1-1, PUB-8): single-source facts; count(*) FROM brands included 'other' (printed 22).
const { brandCount, years, since } = await siteFacts();
/* deploy-audit: CMS block site/about (ar) — title / lead / mission / vision; built-in copy is the fallback */
const about = await arSiteBlock('about');
const F = { years, brandCount, since, skus: Number(productCount) };
const txt = (k: string) => (typeof about[k] === 'string' && about[k].trim() ? factText(about[k], F) : null);
const testimonials = await db`SELECT name, role, company, quote FROM testimonials WHERE active = true ORDER BY id`;
// rm(6.2-2): the /ar/about/#awards anchor must land on a real section (roadmap: "not
// empty anchors"). Award titles are vendor brand names — same payload as the EN page.
const [awardsRow] = await db`SELECT payload FROM content_blocks WHERE entity='site' AND entity_id='awards' AND lang='en'`;
const DEFAULT_AWARDS = [{ year: '2025', title: 'Hikvision — Best Distributor Partner' }, { year: '2025', title: 'TeamGroup — Best Partner 2025' }];
const awardsList: any[] = Array.isArray(awardsRow?.payload) ? awardsRow.payload : DEFAULT_AWARDS;

const leadership = [
  ['رئيس مجلس الإدارة', 'محمد مظهر الإسلام'],
  ['العضو المنتدب', 'محمد ظاهر الإسلام'],
  ['نائب العضو المنتدب', 'إس. إم. محب الحسن']
];

const values = [
  ['الأصالة والشفافية', 'لا مجال لمخاطر السوق الرمادية — كل قطعة معتمدة وموثقة من المصنع مباشرة.'],
  ['المسؤولية والالتزام', 'مكتب استجابة موحد، اتفاقيات مستوى خدمة حقيقية، وفريق دعم يتواصل مباشرة.'],
  ['الشركاء أولاً', 'نجاحنا مرتبط بنجاح موزعينا ومكاملي الأنظمة وشبكة شركائنا في المنطقة.'],
  ['الثقة طويلة الأجل', `أكثر من ${years} عاماً من الاستقرار التشغيلي المبني على الاستمرارية لا الحلول السريعة.`]
];

const milestones = [
  ['2002', 'التأسيس في دبي', 'انطلاق عمليات التوزيع المستقل لتقنية المعلومات في بر دبي.'],
  ['2010', 'مركز جبل علي اللوجستي', 'افتتاح مستودع JAFZA لخدمة قنوات التوزيع في الخليج والشرق الأوسط وأفريقيا.'],
  ['2018', 'التوسع الإقليمي', 'توسيع التوزيع ليشمل أسواق آسيا الوسطى وشبه القارة الهندية.'],
  ['2024', 'شراكة يونيسوفت البرمجية', 'إطلاق خط خدمات البرمجيات المؤسسية ونظام UniERP.'],
  ['2026', 'المنصة الرقمية المتكاملة', 'جاهزية الفوترة الإلكترونية Peppol وتكامل معالج KYC الرقمي للشركاء.']
];

const breadcrumbsSchema = {
  '@type': 'BreadcrumbList',
  '@id': 'https://simalme.com/ar/about/#breadcrumb',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://simalme.com/ar/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'عن سيمال', 'item': 'https://simalme.com/ar/about/' }
  ]
};
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="عن سيمال للتقنيات — موزع البنية التحتية والبرمجيات المعتمد"
  description={`تعرف على سيمال للتقنيات: مسيرة تمتد لأكثر من ${years} عاماً في توزيع مكونات تقنية المعلومات الأصلية والبرمجيات المؤسسية عبر الإمارات والخليج وأفريقيا.`}
  schemas={[breadcrumbsSchema]}
>
  <section class="hero"><div class="wrap" style="padding:56px 28px 50px;display:grid;grid-template-columns:1fr">
    <div>
      <span class="badge b-dark" style="background:rgba(255,255,255,.14);color:#fff">منذ {since} · بيت توزيع مستقل · بر دبي</span>
      <h1 style="font-size:36px;max-width:820px;line-height:1.2;margin:12px 0">{txt('title') ?? 'موزع البنية التحتية التقنية المتكاملة خلف رواد الأعمال بالمنطقة.'}</h1>
      <p class="lead" style="max-width:760px;color:#DAE5F0">{txt('lead') ?? <Fragment>تقوم شركة سيمال للتقنيات الشرق الأوسط ش.ذ.م.م بتوزيع مكونات وأجهزة تقنية المعلومات الأصلية — وسائط التخزين، الذاكرة، الأمان والشبكات، والطاقة — للموزعين ومكاملي الأنظمة ومتاجر التجزئة والتجارة الإلكترونية عبر الإمارات والخليج وأفريقيا وآسيا الوسطى. معتمدة من {brandCount} علامة تجارية عالمية.</Fragment>}</p>
    </div>
  </div></section>

  <!-- Entities & Milestones -->
  <section class="sec" id="why"><div class="wrap">
    <div class="split" style="display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:start">
      <div>
        <span class="eyebrow">المؤسسة والكيانات</span>
        <h2 style="font-size:26px;margin:6px 0 16px">شركة متكاملة بإمكانات شاملة من البداية حتى التسليم</h2>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div class="card card-p" style="display:flex;gap:14px;align-items:center;border-right:4px solid var(--blue)">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--blue-050);color:var(--blue);display:grid;place-items:center;font-weight:700">S</div>
            <div><b>سيمال للتقنيات الشرق الأوسط ش.ذ.م.م</b><p style="margin:2px 0 0;font-size:12px;color:var(--slate)">المقر الرئيسي · بر دبي · مبيعات القنوات وإدارة التوزيع</p></div>
          </div>
          <div class="card card-p" style="display:flex;gap:14px;align-items:center">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--blue-050);color:var(--blue);display:grid;place-items:center;font-weight:700">SS</div>
            <div><b>ستار سيد إم إي (StarSeed ME FZE)</b><p style="margin:2px 0 0;font-size:12px;color:var(--slate)">المستودع المركزي · جبل علي JAFZA · الشحن والخدمات اللوجستية</p></div>
          </div>
          <div class="card card-p" style="display:flex;gap:14px;align-items:center">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--blue-050);color:var(--blue);display:grid;place-items:center;font-weight:700">TC</div>
            <div><b>تكنو سيتي للكمبيوتر (Techno City)</b><p style="margin:2px 0 0;font-size:12px;color:var(--slate)">صالة العرض والتجزئة · دبي · خدمة الشركاء والمبيعات المباشرة</p></div>
          </div>
          <div class="card card-p" style="display:flex;gap:14px;align-items:center">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--blue-050);color:var(--blue);display:grid;place-items:center;font-weight:700">U</div>
            <div><b>يونيسوفت سيستمز المحدودة (Unisoft Systems Ltd)</b><p style="margin:2px 0 0;font-size:12px;color:var(--slate)">الذراع البرمجي والهندسي · دكا · تطوير ERP والذكاء الاصطناعي</p></div>
          </div>
        </div>
      </div>

      <div>
        <span class="eyebrow">المحطات التاريخية</span>
        <h2 style="font-size:26px;margin:6px 0 16px">2002–2026: مسيرة نمو وبناء متواصلة</h2>
        <div style="display:flex;flex-direction:column;gap:16px">
          {milestones.map(m => (
            <div style="display:flex;gap:16px;align-items:flex-start">
              <span class="badge b-blue" style="font-weight:800;font-size:12px;min-width:54px;text-align:center">{m[0]}</span>
              <div>
                <b style="font-size:15px;display:block">{m[1]}</b>
                <p style="font-size:13px;color:var(--slate);margin-top:2px">{m[2]}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div></section>

  <!-- Mission, Vision & Values -->
  <section class="sec" style="background:#fff" id="mission"><div class="wrap">
    <div class="grid g3">
      <div class="card card-p" style="border-top:4px solid var(--blue)">
        <span class="eyebrow">رسالتنا</span>
        <h3 style="font-size:18px;margin:8px 0 10px">الالتزام بالجودة والأصالة</h3>
        <p style="font-size:13px;color:var(--slate);line-height:1.6">{txt('mission') ?? 'تزويد قطاع الأعمال في الشرق الأوسط وأفريقيا بمكونات تقنية المعلومات الأصلية وحلول البرمجيات المؤسسية بضمانات معتمدة، وأسعار قنوات تنافسية، ومستويات خدمة يعتمد عليها.'}</p>
      </div>
      <div class="card card-p" style="border-top:4px solid #16A34A">
        <span class="eyebrow">رؤيتنا</span>
        <h3 style="font-size:18px;margin:8px 0 10px">الريادة الإقليمية المتكاملة</h3>
        <p style="font-size:13px;color:var(--slate);line-height:1.6">{txt('vision') ?? 'أن نكون بيت توزيع التقنية والحلول المتكاملة الرائد في المنطقة — جسراً بين الشركات العالمية المصنعة للعتاد وبرمجيات المؤسسات الحديثة للمطورين والشركاء في كافة الأسواق.'}</p>
      </div>
      <div class="card card-p" style="border-top:4px solid var(--gold-accessible)">
        <span class="eyebrow">قيمنا الراسخة</span>
        <h3 style="font-size:18px;margin:8px 0 10px">المبادئ التوجيهية للعمل</h3>
        <p style="font-size:13px;color:var(--slate);line-height:1.6">الأصالة التامة، تحمل المسؤولية المؤسسية، إعطاء الأولوية القصوى لشركاء التوزيع، وبناء الثقة المستدامة على مدى العقود.</p>
      </div>
    </div>
  </div></section>

  <!-- Leadership Board -->
  <section class="sec" id="leadership"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">القيادة التنفيذية</span><h2>فريق الإدارة ومجلس الإدارة</h2></div></div>
    <div class="grid g3">
      {leadership.map(l => (
        <div class="card card-p" style="text-align:center">
          <div style="width:64px;height:64px;border-radius:50%;background:var(--blue-050);color:var(--blue);display:grid;place-items:center;font-size:22px;font-weight:700;margin:0 auto 14px">
            {l[1].charAt(0)}
          </div>
          <h3 style="font-size:17px;margin-bottom:4px">{l[1]}</h3>
          <span class="badge b-blue">{l[0]}</span>
          <p style="font-size:12.5px;color:var(--slate);margin-top:10px">قيادة استراتيجية لعمليات التوزيع والتحول الرقمي لشركة سيمال للتقنيات.</p>
        </div>
      ))}
    </div>
  </div></section>

  <!-- Awards (rm(6.2-2): real section for the /ar/about/#awards footer anchor) -->
  <section class="sec" id="awards" style="background:#fff;border-top:1px solid var(--line)"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">التقديرات</span><h2>الجوائز وشهادات التقدير</h2></div></div>
    <div class="grid g3">
      {awardsList.map((a: any) => (
        <div class="card card-p" style="text-align:center">
          <span class="badge b-red">🏆 جائزة {a.year}</span>
          <p style="font-weight:700;margin-top:10px">{a.title}</p>
        </div>
      ))}
      <div class="card card-p" style="text-align:center">
        <span class="badge b-line">معتمدون: {brandCount} علامة تجارية</span>
        <p style="font-weight:700;margin-top:10px">من بينها Crucial/Micron وHikvision وUGREEN وTeamGroup</p>
      </div>
    </div>
  </div></section>

  <!-- CSR (rm(6.2-2): real section for the /ar/about/#csr footer anchor) -->
  <section class="sec" id="csr"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">المسؤولية الاجتماعية</span><h2>العطاء المجتمعي في المنطقة</h2></div></div>
    <div class="card card-p" style="max-width:860px">
      <p style="color:var(--slate);font-size:13.5px;line-height:1.75">يستثمر برنامج المسؤولية الاجتماعية لسيمال في مبادرات محو الأمية الرقمية وإتاحة الأجهزة للمجتمعات التي نخدمها — من التبرع بأجهزة مجددة للمدارس إلى برامج التدريب مع جامعات الإمارات.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
        <span class="chip" style="font-size:12.5px;padding:6px 12px;background:#F1F5F9;border-radius:20px">محو الأمية الرقمية</span>
        <span class="chip" style="font-size:12.5px;padding:6px 12px;background:#F1F5F9;border-radius:20px">التبرع بأجهزة مجددة</span>
        <span class="chip" style="font-size:12.5px;padding:6px 12px;background:#F1F5F9;border-radius:20px">تدريب الخريجين</span>
      </div>
    </div>
  </div></section>
</BaseLayout>
