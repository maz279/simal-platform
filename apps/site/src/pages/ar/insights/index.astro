---
// apps/site/src/pages/ar/insights/index.astro — Arabic Insights Hub (SEO-1)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';

// deploy-audit: articles exist in English only (no /ar/insights/<slug> route) — list the EN rows once
const rows = await db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'insight' AND lang = 'en' ORDER BY payload->>'at' DESC NULLS LAST`;
const parse = (r: any) => (typeof r.payload === 'string' ? JSON.parse(r.payload) : r.payload);
const arts = rows.map((r: any) => ({ slug: r.entity_id, ...parse(r) }));

const cats = [...new Set(arts.map(a => a.cat).filter(Boolean))].sort();
const featured = arts[0] || null;
const list = arts.slice(1);

const fmtDate = (iso: string) => {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('ar-EG', { day: 'numeric', month: 'long', year: 'numeric' });
};

const breadcrumbsSchema = {
  '@type': 'BreadcrumbList',
  '@id': 'https://simalme.com/ar/insights/#breadcrumb',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://simalme.com/ar/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'المقالات والأخبار', 'item': 'https://simalme.com/ar/insights/' }
  ]
};
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="المقالات والمركز الإخباري — سيمال للتقنيات"
  description="رؤى استراتيجية وسوقية من واقع التوزيع الفعلي: تقنيات وسائط التخزين، تحديثات كبار المصنعين، ومعايير الامتثال والفوترة الإلكترونية بدولة الإمارات."
  schemas={[breadcrumbsSchema]}
>
  <section class="hero"><div class="wrap" style="padding:52px 28px 48px;display:grid;grid-template-columns:1fr .8fr;gap:28px;align-items:start">
    <div>
      <span class="badge b-dark" style="background:rgba(255,255,255,.14);color:#fff">تحليلات تقنية · من واقع حركة المستودعات والتوزيع</span>
      <h1 style="font-size:34px;line-height:1.2;margin:12px 0">رؤى وأخبار قنوات التوزيع.</h1>
      <p class="lead" style="color:#DAE5F0">استراتيجيات التخزين المؤسسي، حركة الموردين العالميين، وجاهزية الامتثال الضريبي بالإمارات — يكتبها الفريق الذي يتابع السوق ويشحن البضائع يومياً.</p>
    </div>
    <div class="hero-card">
      <h3 style="font-size:16px;margin-bottom:8px">📬 النشرة الشهرية للقنوات</h3>
      <p style="font-size:13px;color:#CFE0F3;margin:8px 0 12px">إشعارات توفر المخزون، العروض الحصرية، ومواعيد تطبيق الفوترة الإلكترونية. اشتراك موثق وإلغاء بنقرة واحدة.</p>
      <input class="in" id="i-mail" placeholder="بريدك الإلكتروني المهني…" style="width:100%;background:rgba(255,255,255,.08);border-color:#2C4159;color:#fff;padding:10px;border-radius:8px;border:1px solid #2C4159" aria-label="البريد الإلكتروني المهني للاشتراك">
      <button class="btn btn-gold btn-block" id="i-go" style="margin-top:10px">اشترك في النشرة</button>
      <p id="i-msg" style="display:none;font-size:12px;color:var(--yellow);margin-top:8px"></p>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">أحدث المقالات</span><h2>من مكاتب التوزيع — {arts.length} تقارير ومقالات تفصيلية</h2></div></div>

    <!-- Category Filters -->
    <div id="filters" style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px">
      <button class="chip on fchip" data-f="ALL" style="cursor:pointer;font-size:13px;padding:8px 16px">كافة المقالات ({arts.length})</button>
      {cats.map(c => {
        const count = arts.filter(a => a.cat === c).length;
        return <button class="chip fchip" data-f={c} style="cursor:pointer;font-size:13px;padding:8px 16px">{c} ({count})</button>;
      })}
    </div>

    <!-- Featured Article Banner — carries data-cat so the chip filter counts it -->
    {featured && (
      <div id="featured" data-cat={featured.cat} style="margin-bottom:24px">
        <div class="card" style="overflow:hidden;position:relative;display:grid;grid-template-columns:300px 1fr;align-items:stretch">
          <div style="min-height:200px;background:linear-gradient(120deg,var(--blue-050),#fff 80%);display:grid;place-items:center;font-size:13px;font-weight:800;color:var(--blue);text-align:center;padding:16px">
            {featured.cat}<br />قراءة في {featured.mins} دقائق<br />{fmtDate(featured.at)}
          </div>
          <div style="padding:24px;display:flex;flex-direction:column;justify-content:center">
            <span class="badge b-blue" style="align-self:flex-start;margin-bottom:8px">مقال مميز</span>
            <h3 style="font-size:22px;margin:0 0 8px"><a href={`/insights/${featured.slug}/`} style="color:var(--ink);text-decoration:none">{featured.t}</a></h3>
            <p style="font-size:14px;color:var(--slate);line-height:1.6;margin-bottom:14px">{featured.x}</p>
            <a class="btn btn-o btn-sm" href={`/insights/${featured.slug}/`} style="align-self:flex-start">قراءة المقال كاملاً ←</a>
          </div>
        </div>
      </div>
    )}

    <!-- Articles Grid -->
    <div class="grid g3" id="art-grid">
      {list.map(a => (
        <div class="card card-p art-item" data-cat={a.cat} style="display:flex;flex-direction:column">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <span class="badge b-blue">{a.cat}</span>
            <span style="font-size:12px;color:var(--slate)">{fmtDate(a.at)}</span>
          </div>
          <h3 style="font-size:16px;margin:8px 0;line-height:1.4"><a href={`/insights/${a.slug}/`} style="color:var(--ink);text-decoration:none">{a.t}</a></h3>
          <p style="font-size:13px;color:var(--slate);line-height:1.55;margin-bottom:14px;flex:1">{a.x}</p>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:12px;border-top:1px solid var(--line)">
            <span style="font-size:12px;color:var(--slate)">⏱ {a.mins} دقائق</span>
            <a href={`/insights/${a.slug}/`} style="font-size:13px;color:var(--blue);font-weight:700">اقرأ المزيد ←</a>
          </div>
        </div>
      ))}
    </div>
  </div></section>

  
  <script src="/assets/js/ar-insights-page.js?v=2" defer></script>
</BaseLayout>
