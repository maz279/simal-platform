---
// apps/site/src/pages/ar/onboarding/index.astro — Arabic Reseller Onboarding & KYC (SEO-1)
import BaseLayout from '../../../layouts/BaseLayout.astro';

const partnerTiers = [
  { t: 'الموزع المعتمد (Authorized)', req: 'رخصة تجارية سارية · مقر في الإقليم · التزام سنوي بـ 25 ألف دولار', margin: 'هوامش تجارية قياسية', terms: 'تسهيلات ائتمانية 30 يوماً (بعد الاعتماد)', best: 'الموزعون الجدد ومتاجر التجزئة' },
  { t: 'الشريك المتميز (Premier)', req: 'حجم مبيعات مثبت · كادر فني معتمد', margin: 'هوامش تفضيلية متدرجة', terms: 'فترات سداد ممتدة + دعم تسويقي MDF', best: 'مكاملو الأنظمة والشركات النامية' },
  { t: 'الشريك النخبوي (Elite)', req: 'تغطية إقليمية استراتيجية وحجم أعمال ريادي', margin: 'أعلى هوامش ربحية + حقوق إقليمية لنظام UniERP', terms: 'اتفاقية شراكة وتسهيلات مخصصة', best: 'الشركات القيادية في المنطقة' }
];

const checklist = [
  { icon: '📄', title: 'رخصة تجارية سارية', desc: 'نسخة مصدقة صادرة من دوائر التنمية الاقتصادية أو سلطات المناطق الحرة بدولة الإمارات.' },
  { icon: '🪪', title: 'إثبات هوية المفوضين بالتوقيع', desc: 'نسخ جواز السفر وبطاقة الهوية الإماراتية للمفوضين رسمياً بالتوقيع وإدارة الشركة.' },
  { icon: '🧾', title: 'شهادة التسجيل الضريبي وبيانات Peppol', desc: 'الرقم الضريبي TRN المكون من 15 رقماً ومعرف Peppol للفوترة الإلكترونية المعتمدة.' },
  { icon: '🏦', title: 'البيانات والمستندات البنكية', desc: 'خطاب مرجعي من البنك أو كشف حساب بنكي معتمد ومختوم يحمل رقم الحساب الدولي IBAN.' }
];

const breadcrumbsSchema = {
  '@type': 'BreadcrumbList',
  '@id': 'https://simalme.com/ar/onboarding/#breadcrumb',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://simalme.com/ar/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'برنامج الشركاء ومعالج KYC', 'item': 'https://simalme.com/ar/onboarding/' }
  ]
};
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="تسجيل الشركاء والموزعين وبوابة KYC — سيمال للتقنيات"
  description="انضم إلى شبكة الشركاء المعتمدين لشركة سيمال للتقنيات. احصل على أسعار الجملة، التسهيلات الائتمانية، والتسجيل الآمن عبر بوابة KYC المؤسسية."
  schemas={[breadcrumbsSchema]}
>
  <div class="wrap" style="padding-top:14px">
    <div class="crumbs"><a href="/ar/">الرئيسية</a> › <b>تسجيل الشركاء ومعالج التحقق (KYC)</b></div>
  </div>

  <!-- Partner Program Tiers -->
  <section style="padding:8px 0 6px"><div class="wrap" id="tiers">
    <div class="sec-head"><div><span class="eyebrow">برنامج الشركاء — معتمد · متميز · نخبوي</span><h1 style="font-size:26px;margin:8px 0 16px">ثلاثة مستويات للشراكة في منظومة موحدة: 21 علامة عالمية + حقوق UniERP</h1></div></div>
    <div class="grid g3" id="tier-grid">
      {partnerTiers.map((t, i) => (
        <div class="card card-p" style={i === 0 ? 'border-top:4px solid var(--blue);' : ''}>
          <span class={`badge ${i === 2 ? 'b-gold' : 'b-blue'}`}>{t.t}{i === 2 ? ' — بالدعوة الخاصة' : ''}</span>
          <p style="font-size:12.5px;color:var(--slate);margin-top:9px"><b>المتطلبات:</b> {t.req}</p>
          <p style="font-size:12.5px;color:var(--slate);margin-top:5px"><b>الهوامش:</b> {t.margin} · <b>التسهيلات:</b> {t.terms}</p>
          <p style="font-size:12.5px;color:var(--slate);margin-top:5px"><b>الأنسب لـ:</b> {t.best}</p>
        </div>
      ))}
    </div>
  </div></section>

  <!-- Official KYC Gateway -->
  <section style="padding:18px 0 64px"><div class="wrap">
    <div class="split" style="grid-template-columns:1.3fr .7fr;align-items:start;gap:28px">
      <div>
        <span class="eyebrow">بوابة التحقق المؤسسي KYC</span>
        <h2 style="font-size:24px;font-weight:800;margin:6px 0 8px">تسجيل رقمي موحد. معاملات تجارية بثقة تامة.</h2>
        <p style="color:var(--slate);margin-bottom:24px;font-size:15px;line-height:1.6">
          تعتمد سيمال للتقنيات دورة عمل مؤتمتة متوافقة بالكامل مع معايير الامتثال ومكافحة غسل الأموال (AML/KYC). تتم معالجة الطلبات بشكل مشفر وتدقيقها من قبل مسؤولي الامتثال خلال يومي عمل.
        </p>

        <!-- Role Gateways -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:28px">
          <div class="card card-p" style="border-top:4px solid var(--blue);display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <span class="badge b-blue" style="margin-bottom:10px">شركاء قنوات التوزيع</span>
              <h3 style="font-size:18px;margin-bottom:8px">تسجيل الموزعين والعملاء (KYC)</h3>
              <p style="font-size:13px;color:var(--slate);line-height:1.55;margin-bottom:16px">
                لموزعي تقنية المعلومات ومكاملي الأنظمة والجهات المتعاقدة الراغبة في الحصول على التسهيلات الائتمانية وأسعار القنوات الخاصة.
              </p>
            </div>
            <div>
              <a href="https://kyc.simalme.com/form.html?role=customer" class="btn btn-p" style="width:100%;text-align:center">بدء طلب تسجيل الموزع ←</a>
            </div>
          </div>

          <div class="card card-p" style="border-top:4px solid #16A34A;display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <span class="badge b-ok" style="margin-bottom:10px">المصنعون والموردون</span>
              <h3 style="font-size:18px;margin-bottom:8px">تسجيل الموردين والمصنعين (KYC)</h3>
              <p style="font-size:13px;color:var(--slate);line-height:1.55;margin-bottom:16px">
                للعلامات التجارية ومصنعي الأجهزة الأصلية والشركاء اللوجستيين الراغبين في الانضمام إلى خطوط التوزيع والتوريد المعتمدة.
              </p>
            </div>
            <div>
              <a href="https://kyc.simalme.com/form.html?role=vendor" class="btn btn-o" style="width:100%;text-align:center">بدء طلب تسجيل المورد ←</a>
            </div>
          </div>
        </div>

        <!-- Document Checklist -->
        <div class="card card-p" style="background:var(--bg);border-color:var(--line)">
          <h3 style="font-size:16px;margin-bottom:14px">قائمة المستندات المطلوبة للتسجيل السريع</h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            {checklist.map(c => (
              <div style="display:flex;gap:12px;align-items:flex-start">
                <span style="font-size:22px">{c.icon}</span>
                <div>
                  <b style="font-size:13.5px;color:var(--ink);display:block">{c.title}</b>
                  <p style="font-size:12px;color:var(--slate);margin-top:2px;line-height:1.5">{c.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Compliance & Portal Direct Access -->
      <aside style="display:flex;flex-direction:column;gap:16px">
        <div class="card card-p" style="border-top:4px solid var(--blue)">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
            <span style="font-size:20px">🛡</span>
            <h3 style="font-size:16px;margin:0">بوابة التحقق المباشرة</h3>
          </div>
          <p style="font-size:13px;color:var(--slate);line-height:1.6;margin-bottom:14px">
            إذا كان لديك حساب شريك معتمد بالفعل، يمكنك تسجيل الدخول إلى البوابة لمتابعة الطلبات، إدارة التسهيلات الائتمانية، وتنزيل الفواتير المعتمدة.
          </p>
          <a href="https://kyc.simalme.com/login.html" class="btn btn-gold btn-block" style="text-align:center">تسجيل الدخول إلى البوابة ◁</a>
        </div>

        <div class="card card-p">
          <h3 style="font-size:15px;margin-bottom:8px">الامتثال والحماية القانونية</h3>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:12.5px;color:var(--slate);line-height:1.6">
            <div>✓ متوافق مع متطلبات مصرف الإمارات المركزي لمكافحة غسل الأموال (AML)</div>
            <div>✓ حماية كاملة للبيانات وفق القانون الاتحادي رقم 45 لسنة 2021 (PDPL)</div>
            <div>✓ جاهزية الفوترة الإلكترونية Peppol وتكامل الرقم الضريبي المعتمد</div>
          </div>
        </div>
      </aside>
    </div>
  </div></section>
</BaseLayout>
