---
// apps/site/src/pages/ar/legal/[slug].astro — Individual Arabic Policy Pages (SEO-1)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';

export async function getStaticPaths() {
  const rows = await db`SELECT slug, lang FROM legal_policies`;
  return rows
    .filter(r => r.lang === 'ar')
    .map(r => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const rows = await db`SELECT slug, title, body, version FROM legal_policies WHERE slug = ${slug} AND lang = 'ar'`;
const doc = rows[0] || null;
if (!doc) return Astro.redirect('/ar/legal');

const all = await db`SELECT slug, title FROM legal_policies WHERE lang = 'ar' ORDER BY slug`;
const paras: string[] = Array.isArray(doc.body) ? doc.body : String(doc.body || '').split(/\n{2,}/).filter(Boolean);

const breadcrumbsSchema = {
  '@type': 'BreadcrumbList',
  '@id': `https://simalme.com/ar/legal/${slug}/#breadcrumb`,
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://simalme.com/ar/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'السياسات والشؤون القانونية', 'item': 'https://simalme.com/ar/legal/' },
    { '@type': 'ListItem', 'position': 3, 'name': doc.title, 'item': `https://simalme.com/ar/legal/${slug}/` }
  ]
};
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={`${doc.title} — سيمال للتقنيات`}
  description={`${doc.title} — وثيقة رسمية صادرة عن شركة سيمال للتقنيات الشرق الأوسط ش.ذ.م.م (إصدار ${doc.version || '1.0'}).`}
  schemas={[breadcrumbsSchema]}
>
  <section class="hero-lg" style="background:linear-gradient(118deg,var(--blue-700) 0%,var(--blue) 50%,#0E6CC4 100%);padding:44px 0 36px">
    <div class="wrap">
      <div class="crumbs" style="font-size:13px;margin-bottom:16px">
        <a href="/ar/" style="color:#CFE0F3">الرئيسية</a> › <a href="/ar/legal/" style="color:#CFE0F3">السياسات والشؤون القانونية</a> › <b style="color:#fff">{doc.title}</b>
      </div>
      <h1 style="color:#fff;font-size:30px;margin:0 0 6px">{doc.title}</h1>
      <p style="color:#9FB6CC;font-size:13px">الإصدار الرسمي: v{doc.version || '1.0'} · متوافق مع القوانين واللوائح الاتحادية المعمول بها في دولة الإمارات</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap" style="display:grid;grid-template-columns:280px 1fr;gap:36px;align-items:start">
      <aside class="card card-p" style="position:sticky;top:88px">
        <b style="font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink);display:block;margin-bottom:12px">كافة السياسات واللوائح</b>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px">
          {all.map(l => (
            <li>
              <a 
                href={`/ar/legal/${l.slug}/`} 
                class={l.slug === slug ? 'btn btn-sm btn-p btn-block' : 'btn btn-sm btn-o btn-block'}
                style="justify-content:flex-start;text-align:right"
              >
                {l.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <article class="card card-p" style="padding:32px;line-height:1.8;font-size:15px;color:var(--ink)">
        {paras.map(p => (
          <p style="margin-bottom:18px">{p}</p>
        ))}
      </article>
    </div>
  </section>
</BaseLayout>
