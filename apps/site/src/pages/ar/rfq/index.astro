---
// apps/site/src/pages/ar/rfq/index.astro — Arabic RFQ Twin Page (SEO-1)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';

const rows = await db`SELECT slug, name, brand FROM products ORDER BY name`;
const catalog = rows;

const breadcrumbsSchema = {
  '@type': 'BreadcrumbList',
  '@id': 'https://simalme.com/ar/rfq/#breadcrumb',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'الرئيسية', 'item': 'https://simalme.com/ar/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'طلب عرض أسعار', 'item': 'https://simalme.com/ar/rfq/' }
  ]
};
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="طلب عرض سعر رسمي (RFQ) — سيمال للتقنيات"
  description="أنشئ طلب عرض أسعار رسمي لأي من منتجاتنا وقطع تقنية المعلومات المخزنة — بدون الحاجة لإنشاء حساب مسبق. رقم مرجعي فوري ورد بأسعار الجملة خلال يوم عمل واحد."
  schemas={[breadcrumbsSchema]}
>
  <div class="wrap"><div class="crumbs"><a href="/ar/">الرئيسية</a> › <b>طلب عرض سعر (RFQ)</b></div></div>

  <section style="padding:8px 0 64px"><div class="wrap">
    <div class="split" style="grid-template-columns:1.25fr .75fr;align-items:start">
      <div>
        <span class="eyebrow">لا شراء عشوائي — تعاملات القنوات تعتمد على عروض الأسعار</span>
        <h1 style="font-size:30px;font-weight:800;margin:6px 0 8px">سلة طلبات عروض الأسعار</h1>
        <p style="color:var(--slate);margin-bottom:20px">راجع كميات المنتجات المطلوبة، أضف بيانات الاتصال بشركتك، ثم أرسل الطلب — ستتلقى <b>رقماً مرجعياً رسمياً SIMAL-RFQ</b> فوراً مع رد تفصيلي بأسعار الجملة خلال يوم عمل واحد. لا حاجة لإنشاء حساب مسبق.</p>

        <div id="rfq-step-1">
          <div class="card card-p" style="padding:20px">
            <form id="addForm" style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap">
              <input class="in" list="products" id="slugInput" placeholder="اكتب اسم المنتج أو اختر من القائمة…" style="flex:1;min-width:200px;padding:10px;border:1px solid var(--line);border-radius:8px" autocomplete="off" aria-label="اسم المنتج أو القطعة">
              <datalist id="products">
                {catalog.map(p => <option value={p.slug}>{p.name} — {p.brand}</option>)}
              </datalist>
              <input class="in" type="number" id="qtyInput" min="1" max="99999" value="1" style="width:90px;padding:10px;border:1px solid var(--line);border-radius:8px" aria-label="الكمية">
              <button class="btn btn-p" type="submit">+ إضافة منتج</button>
            </form>
            {/* rm(9.1-3): server-rendered empty state, identical to render() below (no layout shift) */}
            <div id="basket-tbl"><p style="color:var(--slate);padding:24px 0;text-align:center">سلة طلبات الأسعار فارغة حالياً. أضف منتجات من الكتالوج أو القائمة أعلاه.</p></div>
            <div style="display:flex;justify-content:space-between;margin-top:16px;align-items:center;flex-wrap:wrap;gap:10px">
              <a class="btn btn-o btn-sm" href="/ar/products/">+ تصفح الكتالوج لإضافة المزيد</a>
              <span class="note" style="font-size:12.5px;color:var(--slate)">الأسعار تُحدد حسب الكميات ومستويات الشراكة</span>
            </div>
          </div>

          <h2 style="font-size:19px;margin:30px 0 12px">بيانات الشركة والتواصل والتسليم</h2>
          <div class="card card-p" style="padding:22px">
            <div class="grid g2" style="gap:14px">
              <div>
                <label for="f-co" style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">اسم الشركة أو المؤسسة <span style="color:var(--red)">*</span></label>
                <input class="in" id="f-co" autocomplete="organization" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px">
              </div>
              <div>
                <label for="f-name" style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">الشخص المسؤول <span style="color:var(--red)">*</span></label>
                <input class="in" id="f-name" autocomplete="name" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px">
              </div>
              <div>
                <label for="f-email" style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">البريد الإلكتروني المهني <span style="color:var(--red)">*</span></label>
                <input class="in" id="f-email" dir="ltr" type="email" placeholder="name@company.ae" autocomplete="email" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px">
              </div>
              <div>
                <label for="f-phone" style="display:block;font-size:13px;font-weight:700;margin-bottom:4px">رقم الهاتف / الواتساب <span style="color:var(--red)">*</span></label>
                <input class="in" id="f-phone" dir="ltr" placeholder="+971 …" autocomplete="tel" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:8px">
              </div>
            </div>
            <label style="display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;color:var(--slate);cursor:pointer" for="f-consent">
              <input type="checkbox" id="f-consent" aria-label="أوافق على معالجة البيانات وفق نظام حماية البيانات الشخصية الإماراتي PDPL" style="width:18px;height:18px">
              <span>أوافق على معالجة هذه البيانات لتقديم عرض السعر وفق إشعار الخصوصية ونظام حماية البيانات الإماراتي (PDPL). <span style="color:var(--red)">*</span></span>
            </label>
            <div style="display:flex;gap:12px;margin-top:20px;flex-wrap:wrap">
              <button class="btn btn-p btn-lg" id="f-submit">إرسال طلب السعر رسميّاً ←</button>
              <a class="btn btn-wa btn-lg" id="f-wa" href="https://wa.me/971508487861" target="_blank" rel="noopener noreferrer">المتابعة السريعة عبر واتساب</a>
            </div>
            <p class="hint" style="margin-top:12px;color:var(--danger);font-size:13px" id="f-err" hidden></p>
          </div>
        </div>

        <div id="rfq-step-2" class="card card-p" style="padding:34px;text-align:center" hidden>
          <div style="font-size:44px">✅</div>
          <h2 style="font-size:22px;margin:10px 0 6px">تم استلام طلب السعر وتوليد الرقم المرجعي</h2>
          <p style="color:var(--slate);max-width:540px;margin:0 auto 18px">تم تسجيل طلبكم بنجاح في نظام التوزيع. تم إرسال تفاصيل التأكيد إلى بريدكم الإلكتروني وسيقوم مسؤول المبيعات بالتواصل معكم بعرض سعر رسمي خلال يوم عمل واحد.</p>
          <div style="background:var(--blue-050);padding:14px 20px;border-radius:10px;display:inline-block;margin-bottom:20px">
            <span style="font-size:12.5px;color:var(--slate);display:block">الرقم المرجعي الرسمي:</span>
            <b id="refCode" style="font-size:20px;color:var(--blue);letter-spacing:1px">SIMAL-RFQ-000000</b>
          </div>
          <br>
          <a class="btn btn-p" href="/ar/products/">العودة إلى الكتالوج لتصفح المزيد ←</a>
        </div>
      </div>

      <!-- Trust sidebar -->
      <aside style="display:flex;flex-direction:column;gap:16px">
        <div class="card card-p" style="border-top:4px solid var(--blue)">
          <h3 style="font-size:16px;margin-bottom:8px">لماذا يتم التعامل عبر طلبات الأسعار؟</h3>
          <p style="font-size:13px;color:var(--slate);line-height:1.6">تعتمد قنوات التوزيع B2B على أسعار متدرجة حسب حجم الطلبيات ومستويات الشركاء المسجلين وتكاليف الشحن الإقليمية من مستودعات جبل علي.</p>
        </div>
        <div class="card card-p">
          <h3 style="font-size:16px;margin-bottom:8px">سرعة الاستجابة والتسليم</h3>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:13px;color:var(--ink)">
            <div>✓ تسليم داخل الإمارات: خلال يوم العمل التالي من جبل علي</div>
            <div>✓ الشحن لدول الخليج: خلال نفس الأسبوع مع أرقام التتبع</div>
            <div>✓ منتجات أصلية معتمدة بضمان محلي معتمد</div>
          </div>
        </div>
      </aside>
    </div>
  </div></section>

  <script>
    let basket: any[] = [];
    const tbl = document.getElementById('basket-tbl');
    const err = document.getElementById('f-err');

    const render = () => {
      if (!tbl) return;
      if (!basket.length) {
        tbl.innerHTML = '<p style="color:var(--slate);padding:24px 0;text-align:center">سلة طلبات الأسعار فارغة حالياً. أضف منتجات من الكتالوج أو القائمة أعلاه.</p>';
        return;
      }
      tbl.innerHTML = `
        <table class="tbl" style="width:100%;border-collapse:collapse;margin-top:10px">
          <thead>
            <tr style="border-bottom:2px solid var(--line);text-align:right">
              <th style="padding:10px 8px;font-size:13px">المنتج والقطعة</th>
              <th style="padding:10px 8px;font-size:13px;width:120px">الكمية</th>
              <th style="padding:10px 8px;font-size:13px;width:70px">إجراء</th>
            </tr>
          </thead>
          <tbody>
            ${basket.map((it, idx) => `
              <tr style="border-bottom:1px solid var(--line)">
                <td style="padding:12px 8px">
                  <b>${it.name || it.slug}</b>
                </td>
                <td style="padding:12px 8px">
                  <input type="number" min="1" max="99999" value="${it.qty || 1}" class="in q-edit" data-slug="${it.slug}" style="width:80px;padding:6px;border:1px solid var(--line);border-radius:6px">
                </td>
                <td style="padding:12px 8px">
                  <button class="btn btn-sm btn-g del-btn" data-slug="${it.slug}" style="color:var(--danger)">حذف</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;

      document.querySelectorAll('.del-btn').forEach(b => {
        b.addEventListener('click', async () => {
          const s = b.getAttribute('data-slug');
          if (s) {
            await fetch('/api/rfq-basket', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug: s })
            });
            load();
          }
        });
      });

      document.querySelectorAll('.q-edit').forEach(inp => {
        inp.addEventListener('change', async (e) => {
          const s = inp.getAttribute('data-slug');
          const val = parseInt((e.target as HTMLInputElement).value, 10);
          if (s && val > 0) {
            await fetch('/api/rfq-basket', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug: s, qty: val, set: true })
            });
            load();
          }
        });
      });
    };

    const load = async () => {
      try {
        const r = await fetch('/api/rfq-basket');
        const j = await r.json();
        basket = j.basket || j.items || [];
        render();
        const rfqCount = document.getElementById('rfqCount');
        if (rfqCount) rfqCount.textContent = String(j.totalQty ?? 0);
      } catch {}
    };
    load();

    document.getElementById('addForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const s = (document.getElementById('slugInput') as HTMLInputElement).value.trim();
      const q = parseInt((document.getElementById('qtyInput') as HTMLInputElement).value, 10) || 1;
      if (!s) return;
      await fetch('/api/rfq-basket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: s, qty: q })
      });
      (document.getElementById('slugInput') as HTMLInputElement).value = '';
      (window as any).showToast?.('تمت إضافة المنتج إلى السلة ✓', 'ok');
      load();
    });

    document.getElementById('f-submit')?.addEventListener('click', async () => {
      if (err) err.hidden = true;
      if (!basket.length) {
        if (err) { err.textContent = 'يرجى إضافة منتج واحد على الأقل إلى السلة.'; err.hidden = false; }
        return;
      }
      const co = (document.getElementById('f-co') as HTMLInputElement).value.trim();
      const name = (document.getElementById('f-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('f-email') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('f-phone') as HTMLInputElement).value.trim();
      const consent = (document.getElementById('f-consent') as HTMLInputElement).checked;

      if (!co || !name || !email || !phone) {
        if (err) { err.textContent = 'يرجى إكمال جميع الحقول المطلوبة (*).'; err.hidden = false; }
        return;
      }
      if (!consent) {
        if (err) { err.textContent = 'يرجى الموافقة على معالجة البيانات للمتابعة.'; err.hidden = false; }
        return;
      }

      const submitBtn = document.getElementById('f-submit');
      if (submitBtn) submitBtn.textContent = 'جاري الإرسال…';

      try {
        const r = await fetch('/api/rfq', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          /* deploy-audit D04: the server contract is { company, contactName, email, phone } and it
           * answers { reference }; this page sent contact_person and read res.ref, so every
           * Arabic RFQ got 400 "Contact name is required". The basket is the cookie basket. */
          body: JSON.stringify({ company: co, contactName: name, email, phone, lang: 'ar' })
        });
        const res = await r.json();
        if (r.ok && res.reference) {
          const s1 = document.getElementById('rfq-step-1');
          const s2 = document.getElementById('rfq-step-2');
          const refEl = document.getElementById('refCode');
          if (refEl) refEl.textContent = res.reference;
          if (s1) s1.hidden = true;
          if (s2) s2.hidden = false;
          (window as any).showToast?.('تم إرسال طلب السعر بنجاح ✓', 'ok');
        } else {
          if (err) { err.textContent = res.error || 'حدث خطأ أثناء الإرسال. يرجى المحاولة لاحقاً.'; err.hidden = false; }
          if (submitBtn) submitBtn.textContent = 'إرسال طلب السعر رسميّاً ←';
        }
      } catch {
        if (err) { err.textContent = 'تعذر الاتصال بالخادم. يرجى التحقق من اتصال الإنترنت.'; err.hidden = false; }
        if (submitBtn) submitBtn.textContent = 'إرسال طلب السعر رسميّاً ←';
      }
    });
  </script>
</BaseLayout>
