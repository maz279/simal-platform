---
// products/index.astro — Catalog. VISUAL CONTRACT: Prototype category.html ported
// 1:1 — hero, crumbs, facets rail (category/brand/stock), sort chips, .prod card grid
// with Add-to-RFQ wired to the real basket API, pager, per-category buying guide,
// sparse-results help band, recently viewed. Filters/sort run client-side on the
// fully-hydrated SSG grid (same behavior contract as category.js).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../lib/db';
import { siteFacts } from '../../lib/facts';

const products = await db`SELECT slug, name, brand, cat, cat_label, short, sku, imgs, stock, is_new FROM products ORDER BY brand, name`;
const cats = [...new Map(products.map((p: any) => [p.cat, { cat: p.cat, label: p.cat_label || p.cat }])).values()];
const catCounts: Record<string, number> = {};
const brandCounts: Record<string, number> = {};
for (const p of products as any[]) {
  catCounts[p.cat] = (catCounts[p.cat] || 0) + 1;
  brandCounts[p.brand] = (brandCounts[p.brand] || 0) + 1;
}
const brands = Object.keys(brandCounts).sort((a, b) => a.localeCompare(b));
// rm(6.1-2/9.1-1, PUB-8): the published brand count is the single-source one; brands.length
// above is the facet list (raw product.brand values, incl. 'other' and case duplicates).
const { brandCount } = await siteFacts();
/* deploy-audit (platform run #14: /products/ CLS 0.135 > 0.05): the facet rail, count line and
 * pager were empty in the HTML and the buying-guide card visible, so catalog-island.js moved the
 * whole page on load (on mobile the rail sits above the grid). The default view — all
 * categories, featured order, page 1 — is now rendered here exactly as the island renders it,
 * so its first pass changes nothing. Keep this markup in step with renderFacets()/apply(). */
const PER = 12;
const pages = Math.max(1, Math.ceil(products.length / PER));
const cap = (v: string) => (v ? v.charAt(0).toUpperCase() + v.slice(1) : v);
const facetCats = [{ cat: 'all', label: 'All', n: products.length }, ...cats.map((c: any) => ({ cat: c.cat, label: c.cat.replace(/-/g, ' '), n: catCounts[c.cat] }))]; /* the island's label rule */
const imgOf = (imgs: unknown): string => {
  const v = Array.isArray(imgs) ? imgs[0] : (typeof imgs === 'string' && imgs !== 'null' ? JSON.parse(imgs)[0] : '');
  return v && !v.startsWith('/') ? '/' + v : v;
};
/* Category buying guides — queried from DB category_guides with static fallback */
const dbCategoryGuides = await db`SELECT cat, points FROM category_guides`;
const dbGuideMap = new Map((dbCategoryGuides as any[]).map(g => [g.cat, Array.isArray(g.points) ? g.points : (typeof g.points === 'string' ? JSON.parse(g.points) : [])]));

const GUIDE: Record<string, { intro: string; points: string[] }> = {
  'internal-ssd': { 
    intro: 'From next-generation NVMe SSDs to proven SATA drives — the building blocks of modern computing, sourced directly from authorized manufacturers including Crucial, HIKVISION and TEAMGROUP.', 
    points: (dbGuideMap.get('internal-ssd')?.length ? dbGuideMap.get('internal-ssd') : ['PCIe Gen3 → Gen5 NVMe, up to 12,400 MB/s read', 'Genuine manufacturer stock with local UAE warranty', 'Volume channel pricing via RFQ — tiers for resellers'])
  },
  'portable-ssd': { 
    intro: 'Rugged, pocket-sized external drives from Samsung, SanDisk, Crucial and Kingston — USB-C speed for creators, field teams and backups.', 
    points: (dbGuideMap.get('portable-ssd')?.length ? dbGuideMap.get('portable-ssd') : ['Up to 2TB pocket storage, USB 3.2 / Gen2 speeds', 'IP-rated rugged models for site work', 'Bundle options with UGREEN hubs and cables'])
  },
  memory: { 
    intro: 'DDR4 and DDR5 UDIMM/SO-DIMM modules from Crucial and Kingston — plug-and-play upgrades tested across Intel and AMD platforms.', 
    points: (dbGuideMap.get('memory')?.length ? dbGuideMap.get('memory') : ['DDR5 up to 5,600+ MT/s · DDR4 up to 3,200 MT/s', 'XMP 2.0/3.0 profiles, non-ECC desktop and laptop', 'Micron manufacturing behind every Crucial module'])
  },
  monitors: { 
    intro: 'KOORUI and Aiwa displays covering gaming, professional and everyday productivity — color-accurate panels up to 280 Hz refresh.', 
    points: (dbGuideMap.get('monitors')?.length ? dbGuideMap.get('monitors') : ['FHD → QHD, 75–280 Hz, FreeSync support', 'VESA-mount ready slim designs', 'Fleet pricing for office rollouts'])
  },
  accessories: { 
    intro: 'UGREEN docks, cables and adapters plus Honeywell surge protection — the reliable layer between systems and the wall.', 
    points: (dbGuideMap.get('accessories')?.length ? dbGuideMap.get('accessories') : ['USB-C hubs and docking stations to 13-in-1', 'Cat6/7 networking and certified video cables', 'Surge-protected power for office and retail'])
  },
};
---

<BaseLayout title="Product Catalog — Simal Technologies" description={`${products.length} SKUs · ${brandCount} authorized brands — genuine stock, JAFZA-fulfilled, channel pricing by RFQ.`}>
  <section class="hero" style="padding:0"><div class="wrap" style="padding:46px 28px 40px;grid-template-columns:1fr">
    <div>
      <span class="badge b-dark" style="background:rgba(255,255,255,.14);color:#fff">live catalog · ported from simalme.com</span>
      <h1 style="font-size:34px" id="cat-title">All products</h1>
      <p class="lead" id="cat-sub">Every SKU, spec and photo — genuine stock, JAFZA-fulfilled.</p>
    </div>
  </div></section>

  <div class="wrap"><div class="crumbs"><a href="/">Home</a> › <a href="/products/">Products</a> › <b id="crumb">All</b></div></div>

  <section style="padding:6px 0 60px"><div class="wrap">
    <!-- Anchor targets for category deep-links and aliases -->
    <div id="cat-anchors" style="position:relative;top:-70px;height:0;overflow:hidden" aria-hidden="true">
      {cats.map((c: any) => (
        <>
          <span id={c.cat}></span>
          <span id={`cat-${c.cat}`}></span>
        </>
      ))}
      <span id="storage"></span>
      <span id="cat-storage"></span>
      {/* targets for the server-rendered facet "All" and pager links (link-crawl: no dangling #anchors) */}
      <span id="all"></span>
      {Array.from({ length: pages }, (_, i) => <span id={`page${i + 1}`}></span>)}
    </div>
    <div class="card card-p" id="cat-guide" style="margin-bottom:20px;border-top:4px solid var(--g3);display:none"></div>
    <div class="split" style="grid-template-columns:250px 1fr;align-items:start">
      <aside class="card card-p" style="padding:18px;position:sticky;top:66px" aria-label="Filters">
        <h2 class="sr-only">Catalog Filters</h2>
        <h3 style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin-bottom:10px">Category</h3>
        <div id="f-cat" style="display:flex;flex-direction:column;gap:6px;font-size:13.5px">
          {facetCats.map((c) => (
            <a href={`#${c.cat}`} data-c={c.cat} class={`filterlink${c.cat === 'all' ? ' on' : ''}`} aria-current={c.cat === 'all' ? 'true' : undefined}
              style="color:inherit;text-decoration:none;display:flex;justify-content:space-between"><span>{cap(c.label)}</span><span style="font-size:11.5px;color:var(--slate-500)">{c.n}</span></a>
          ))}
        </div>
        <h3 style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin:18px 0 10px">Brand</h3>
        <div id="f-brand" style="display:flex;flex-direction:column;gap:6px;font-size:13.5px;max-height:260px;overflow:auto">
          {brands.map((b) => (
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer"><input type="checkbox" data-b={b} aria-label={`Filter by brand ${b}`} /><span>{b}</span><span style="margin-left:auto;font-size:11.5px;color:var(--slate-500);background:var(--bg);border-radius:6px;padding:1px 7px">{brandCounts[b]}</span></label>
          ))}
        </div>
        <h3 style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--slate);margin:18px 0 10px">Availability</h3>
        <label class="consent" style="margin:0"><input type="checkbox" id="f-stock" aria-label="In stock products only"><span>In stock only</span></label>
        <button class="btn btn-o btn-sm btn-block" style="margin-top:16px" id="f-clear">Clear filters</button>
      </aside>
      <div>
        <h2 class="sr-only">Product List</h2>
        <div style="display:flex;gap:10px;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap">
          <span class="note" id="count-note">{products.length} SKU{products.length === 1 ? '' : 's'} · page 1 of {pages}</span>
          <div style="display:flex;gap:10px;align-items:center" id="sortbar" role="toolbar" aria-label="Sort products"><span class="note">Sort:</span>
            <button type="button" class="chip on" data-sort="featured" aria-pressed="true">Featured</button>
            <button type="button" class="chip" data-sort="newest" aria-pressed="false">Newest</button>
            <button type="button" class="chip" data-sort="brand" aria-pressed="false">Brand A–Z</button>
            <button type="button" class="chip" data-sort="name" aria-pressed="false">Name A–Z</button>
          </div>
        </div>
        <div class="grid g3" id="grid">
          {products.map((p: any, i: number) => {
            const im = imgOf(p.imgs);
            const sku = p.sku || ''; /* deploy-audit: no SKU is invented — 31 products have none, and the slug prefix used to be shown as one */
            return (
              <div class="prod" data-brand={p.brand} data-cat={p.cat} data-name={p.name.toLowerCase()} data-slug={p.slug} data-new={p.is_new ? '1' : '0'} data-stock={p.stock === true ? '1' : '0'} style={i >= PER ? 'display:none' : undefined}>
                <a class="go" href={`/products/${p.slug}`} aria-label={`View details — ${p.name}`}></a>
                <div class={`ph${im ? ' has-img' : ''}`}>
                  {im && <img src={im} alt={p.name} loading="lazy" />}
                  {sku && <span class="sk">{sku}</span>}
                  {p.is_new && <span class="tag badge b-red">NEW</span>}
                </div>
                <div class="pb">
                  <span class="cat">{p.brand} · {p.cat_label || p.cat}</span>
                  <h3><a href={`/products/${p.slug}`} style="color:inherit;text-decoration:none">{p.name}</a></h3>
                  <span class="meta">{p.short || ''}</span>
                  <span class="vd">View details →</span>
                  <div class="pr"><span class="price">RFQ · no list price</span>
                    <button class="btn btn-sm btn-p add-rfq" data-slug={p.slug}>Add to RFQ</button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
        <div class="pagebar" id="pager">
          {pages > 1 && Array.from({ length: pages }, (_, i) => (
            <a href={`#page${i + 1}`} class={i === 0 ? 'on' : ''} data-p={i + 1} aria-current={i === 0 ? 'page' : undefined} aria-label={`Page ${i + 1}`}>{i + 1}</a>
          ))}
        </div>
        <div class="card card-p" id="grid-help" style="margin-top:22px;border-top:4px solid var(--g3);display:none"></div>
      </div>
    </div>

    <div class="sec-head" style="margin-top:42px;display:none" id="recent-head"><div><span class="eyebrow">Where you have been</span><h2>Recently viewed</h2></div></div>
    <div class="grid g4" id="recent" style="display:none"></div>
  </div></section>
</BaseLayout>



<script type="application/json" id="guide-data" set:html={JSON.stringify(GUIDE)} />
<style>
  /* category page uses prototype classes exclusively; only the filterlink list needs
   * a small tweak so the sticky rail scrolls under the mini header */
  .split > aside { max-height: calc(100vh - 90px); overflow: auto; }
  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr !important; }
    .split > aside { position: static; max-height: none; max-width: 100%; }
    #sortbar { flex-wrap: wrap; } /* chip row min-content was forcing 382px */
  }
</style>

<script src="/assets/js/catalog-island.js" defer></script>
<script src="/assets/js/add-rfq.js" defer></script>
