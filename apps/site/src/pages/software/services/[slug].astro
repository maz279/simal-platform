---
// software/services/[slug].astro — software service detail (12 services, 36 sub-services)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';

export async function getStaticPaths() {
  const rows = await db`SELECT entity_id FROM content_blocks WHERE entity = 'software_service' AND lang = 'en'`;
  return rows.map(r => ({ params: { slug: r.entity_id } }));
}

const { slug } = Astro.params;
const rows = await db`SELECT payload FROM content_blocks WHERE entity = 'software_service' AND entity_id = ${slug} AND lang = 'en'`;
const s = rows[0] ? (typeof rows[0].payload === 'string' ? JSON.parse(rows[0].payload) : rows[0].payload) : null;
if (!s) return Astro.redirect('/software');
const all = await db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'software_service' AND lang = 'en' ORDER BY entity_id`;
const related = all.filter(r => r.entity_id !== slug).slice(0, 4).map(r => typeof r.payload === 'string' ? JSON.parse(r.payload) : r.payload);
const subs = s.subs || [];
---

<BaseLayout title={`${s.name || s.id} — Software Services — Simal`} description={s.overview?.slice(0, 150)}>
  <section class="hero-sw">
    <div class="container">
      <div class="crumbs"><a href="/">Home</a> › <a href="/software">Software</a> › <a href="/software#services">Services</a> › <b>{s.name || s.id}</b></div>
      <h1>{s.name || s.id}</h1>
      <p class="tagline">{(s.overview || '').slice(0, 180)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Overview</h2>
      <p class="overview">{s.overview}</p>

      {s.how && s.how.length > 0 && (
        <>
          <h2>How we work</h2>
          <div class="timeline">
            {s.how.map(([t, d]: [string, string]) => (
              <div class="step"><b>{t}</b><span>{d}</span></div>
            ))}
          </div>
        </>
      )}

      {subs.length > 0 && (
        <>
          <h2>What we deliver — {subs.length} practices</h2>
          <div class="subs">
            {subs.map((sub: any) => (
              <div class="sub" id={sub.id}>
                <h3>{sub.name}</h3>
                <p>{sub.what}</p>
                {sub.gives && (
                  <div class="gives">
                    <b>You get</b>
                    <ul>{sub.gives.map((g: string) => <li>{g}</li>)}</ul>
                  </div>
                )}
                {sub.stack && (
                  <div class="stack">
                    <b>Typical stack</b>
                    <div class="chips">{sub.stack.map((t: string) => <span class="chip">{t}</span>)}</div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </>
      )}

      {s.faq && s.faq.length > 0 && (
        <>
          <h2>Common questions</h2>
          <div class="grid-2">
            {s.faq.map(([q, a]: [string, string]) => (
              <div class="faq-card"><b>Q · {q}</b><p>{a}</p></div>
            ))}
          </div>
        </>
      )}

      <h2>Other software services</h2>
      <div class="grid-4">
        {related.map((r: any) => (
          <a href={`/software/services/${r.id}`} class="rel-card">
            <b>{r.name || r.id}</b>
            <p>{(r.overview || '').slice(0, 80)}…</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sw { background: var(--grad-blue-gold); padding: 44px 0 36px; }
  .container { max-width: 1600px; margin: 0 auto; padding: 0 32px; }
  .crumbs { font-size: 13px; margin-bottom: 16px; }
  .crumbs a { color: #CFE0F3; }
  .crumbs b { color: #fff; }
  .hero-sw h1 { color: #fff; font-size: 32px; margin: 0 0 8px; }
  .tagline { color: #DAE5F0; font-size: 15px; max-width: 720px; }

  .section { padding: 44px 0; }
  .section h2 { font-size: 24px; color: var(--navy-800); margin: 32px 0 16px; }
  .section h2:first-child { margin-top: 0; }
  .overview { font-size: 15.5px; line-height: 1.8; color: var(--slate); max-width: 900px; }

  .timeline { display: grid; gap: 12px; max-width: 760px; }
  .step { display: flex; gap: 16px; padding: 14px 18px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); border-left: 4px solid var(--gold); }
  .step b { font-size: 14px; color: var(--blue); min-width: 130px; }
  .step span { font-size: 13.5px; color: var(--slate); }

  .subs { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 16px; }
  .sub { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; border-top: 4px solid var(--blue); }
  .sub h3 { margin: 0 0 10px; font-size: 16px; color: var(--navy-800); }
  .sub p { font-size: 13.5px; color: var(--slate); line-height: 1.7; }
  .gives b, .stack b { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--blue); display: block; margin: 12px 0 6px; }
  .gives ul { padding-left: 18px; margin: 0; }
  .gives li { font-size: 13px; color: var(--slate); margin: 3px 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font-size: 11.5px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: #EEF4FB; color: var(--blue); }

  .grid-2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .faq-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; }
  .faq-card b { font-size: 14px; color: var(--blue); }
  .faq-card p { font-size: 13.5px; color: var(--slate); margin: 8px 0 0; line-height: 1.7; }

  .rel-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; color: inherit; }
  .rel-card:hover { border-color: var(--blue); }
  .rel-card b { font-size: 14px; display: block; }
  .rel-card p { font-size: 12.5px; color: var(--slate); margin: 6px 0 0; }
</style>
