---
// software/solutions/[slug].astro — solution deep-dive (20 records)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';

export async function getStaticPaths() {
  const rows = await db`SELECT entity_id FROM content_blocks WHERE entity = 'software_solution' AND lang = 'en'`;
  return rows.map(r => ({ params: { slug: r.entity_id } }));
}

const { slug } = Astro.params;
const rows = await db`SELECT payload FROM content_blocks WHERE entity = 'software_solution' AND entity_id = ${slug} AND lang = 'en'`;
const s = rows[0] ? (typeof rows[0].payload === 'string' ? JSON.parse(rows[0].payload) : rows[0].payload) : null;
if (!s) return Astro.redirect('/software');

/* cross-nav lookups: modules / services / related solutions all resolve */
const [mods, svcs, sols] = await Promise.all([
  db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'software_module' AND lang = 'en'`,
  db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'software_service' AND lang = 'en'`,
  db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'software_solution' AND lang = 'en' ORDER BY entity_id`,
]);
const parse = (r: any) => (typeof r.payload === 'string' ? JSON.parse(r.payload) : r.payload);
const modMap = new Map(mods.map(r => [r.entity_id, parse(r)]));
const svcMap = new Map(svcs.map(r => [r.entity_id, parse(r)]));
const solMap = new Map(sols.map(r => [r.entity_id, parse(r)]));
const modules = (s.modules || []).map((id: string) => modMap.get(id)).filter(Boolean);
const services = (s.services || []).map((id: string) => svcMap.get(id)).filter(Boolean);
const related = (s.related || []).map((id: string) => solMap.get(id)).filter(Boolean);
---

<BaseLayout title={`${s.name || s.id} — Solutions — Simal`} description={(s.what || '').slice(0, 150)}>
  <section class="hero-sw">
    <div class="container">
      <div class="crumbs"><a href="/">Home</a> › <a href="/software">Software</a> › <a href="/software#solutions">Solutions</a> › <b>{s.name || s.id}</b></div>
      <h1>{s.name || s.id}</h1>
      <p class="tagline">{(s.what || '').slice(0, 200)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What this is</h2>
      <p class="overview">{s.what}</p>

      {s.caps && s.caps.length > 0 && (
        <>
          <h2>Capabilities</h2>
          <div class="grid-3">
            {s.caps.map(([cap, feats]: [string, string[]]) => (
              <div class="cap-card">
                <b>{cap}</b>
                <ul>{feats.map((f: string) => <li>{f}</li>)}</ul>
              </div>
            ))}
          </div>
        </>
      )}

      {s.flow && s.flow.length > 0 && (
        <>
          <h2>How it lands</h2>
          <div class="timeline">
            {s.flow.map(([t, d]: [string, string]) => <div class="step"><b>{t}</b><span>{d}</span></div>)}
          </div>
        </>
      )}

      {s.deploy && <div class="deploy"><h2>Deployment</h2><p>{s.deploy}</p></div>}

      {s.why && s.why.length > 0 && (
        <>
          <h2>Why teams choose it</h2>
          <div class="grid-3">{s.why.map((w: string) => <div class="why-card">{w}</div>)}</div>
        </>
      )}

      {modules.length > 0 && (
        <>
          <h2>Modules in this solution</h2>
          <div class="grid-4">
            {modules.map((m: any) => (
              <a href={`/software/modules/${m.id}`} class="rel-card"><span class="ic">{m.icon}</span><b>{m.name}</b><p>{(m.tag || '').slice(0, 80)}</p></a>
            ))}
          </div>
        </>
      )}

      {services.length > 0 && (
        <>
          <h2>Delivered with</h2>
          <div class="grid-4">
            {services.map((v: any) => (
              <a href={`/software/services/${v.id}`} class="rel-card gold"><b>{v.name || v.id}</b><p>{(v.overview || '').slice(0, 80)}…</p></a>
            ))}
          </div>
        </>
      )}

      {s.faq && s.faq.length > 0 && (
        <>
          <h2>Common questions</h2>
          <div class="grid-2">
            {s.faq.map(([q, a]: [string, string]) => <div class="faq-card"><b>Q · {q}</b><p>{a}</p></div>)}
          </div>
        </>
      )}

      {related.length > 0 && (
        <>
          <h2>Related solutions</h2>
          <div class="grid-4">
            {related.map((r: any) => (
              <a href={`/software/solutions/${r.id}`} class="rel-card"><b>{r.name || r.id}</b><p>{(r.what || '').slice(0, 80)}…</p></a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sw { background: var(--grad-blue-gold); padding: 44px 0 36px; }
  .container { max-width: 1600px; margin: 0 auto; padding: 0 32px; }
  .crumbs { font-size: 13px; margin-bottom: 16px; }
  .crumbs a { color: #CFE0F3; }
  .crumbs b { color: #fff; }
  .hero-sw h1 { color: #fff; font-size: 32px; margin: 0 0 8px; }
  .tagline { color: #DAE5F0; font-size: 15px; max-width: 760px; }

  .section { padding: 44px 0; }
  .section h2 { font-size: 24px; color: var(--navy-800); margin: 32px 0 16px; }
  .section h2:first-child { margin-top: 0; }
  .overview { font-size: 15.5px; line-height: 1.8; color: var(--slate); max-width: 900px; }

  .grid-2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }

  .cap-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; border-top: 4px solid var(--blue); }
  .cap-card b { font-size: 14.5px; }
  .cap-card ul { padding-left: 16px; margin: 8px 0 0; }
  .cap-card li { font-size: 13px; color: var(--slate); margin: 4px 0; }

  .timeline { display: grid; gap: 12px; max-width: 760px; }
  .step { display: flex; gap: 16px; padding: 14px 18px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); border-left: 4px solid var(--gold); }
  .step b { font-size: 14px; color: var(--blue); min-width: 130px; }
  .step span { font-size: 13.5px; color: var(--slate); }

  .deploy { background: #F6F9FC; border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 22px 18px; max-width: 900px; }
  .deploy p { font-size: 14px; color: var(--slate); line-height: 1.75; }

  .why-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; font-size: 14px; color: var(--slate); line-height: 1.7; border-top: 4px solid var(--gold); }

  .faq-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; }
  .faq-card b { font-size: 14px; color: var(--blue); }
  .faq-card p { font-size: 13.5px; color: var(--slate); margin: 8px 0 0; line-height: 1.7; }

  .rel-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; color: inherit; }
  .rel-card:hover { border-color: var(--blue); }
  .rel-card.gold { border-top: 3px solid var(--gold); }
  .rel-card .ic { font-size: 22px; display: block; margin-bottom: 6px; }
  .rel-card b { font-size: 14px; display: block; }
  .rel-card p { font-size: 12.5px; color: var(--slate); margin: 6px 0 0; }
</style>
