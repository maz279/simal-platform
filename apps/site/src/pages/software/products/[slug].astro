---
// software/products/[slug].astro — software product detail (20 records)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { db } from '../../../lib/db';

export async function getStaticPaths() {
  const rows = await db`SELECT entity_id FROM content_blocks WHERE entity = 'software_product' AND lang = 'en'`;
  return rows.map(r => ({ params: { slug: r.entity_id } }));
}

const { slug } = Astro.params;
const rows = await db`SELECT payload FROM content_blocks WHERE entity = 'software_product' AND entity_id = ${slug} AND lang = 'en'`;
const p = rows[0] ? (typeof rows[0].payload === 'string' ? JSON.parse(rows[0].payload) : rows[0].payload) : null;
if (!p) return Astro.redirect('/software');
const all = await db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'software_product' AND lang = 'en' ORDER BY entity_id`;
const related = all.filter(r => r.entity_id !== slug).slice(0, 4).map(r => typeof r.payload === 'string' ? JSON.parse(r.payload) : r.payload);
const grpLabel = p.grp === 'erp' ? 'UniERP Platform' : 'Specialized';
---

<BaseLayout title={`${p.name} — Software — Simal`} description={p.desc}>
  <section class="hero-sw">
    <div class="container">
      <div class="crumbs"><a href="/">Home</a> › <a href="/software">Software</a> › <a href="/software#products">Products</a> › <b>{p.name}</b></div>
      <div class="title-row">
        <span class="icon">{p.icon}</span>
        <div>
          <h1>{p.name}</h1>
          <p class="tagline">{p.desc}</p>
          <div class="chips">
            <span class="chip">{grpLabel}</span>
            {p.star && <span class="chip gold">Flagship</span>}
            {p.target && <span class="chip">{p.target}</span>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {p.feats && p.feats.length > 0 && (
        <>
          <h2>Core capabilities</h2>
          <div class="grid-3">
            {p.feats.map((f: string) => (
              <div class="feat-card"><b>{f}</b></div>
            ))}
          </div>
        </>
      )}

      <h2>Built for</h2>
      <p class="overview">{p.target || 'Businesses that need this capability integrated with their operations from day one.'}</p>

      <div class="cta-row">
        <a href="/contact" class="cta">Book a demo</a>
        <a href="/contact" class="cta secondary">Request consultation</a>
      </div>

      <h2>More software products</h2>
      <div class="grid-4">
        {related.map((r: any) => (
          <a href={`/software/products/${r.id}`} class="rel-card">
            <span class="icon sm">{r.icon}</span>
            <b>{r.name}</b>
            <p>{(r.desc || '').slice(0, 90)}…</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-sw { background: var(--grad-blue-gold); padding: 44px 0 36px; }
  .container { max-width: 1600px; margin: 0 auto; padding: 0 32px; }
  .crumbs { font-size: 13px; margin-bottom: 16px; }
  .crumbs a { color: #CFE0F3; }
  .crumbs b { color: #fff; }
  .title-row { display: flex; gap: 20px; align-items: flex-start; }
  .icon { font-size: 44px; line-height: 1; }
  .icon.sm { font-size: 24px; display: block; margin-bottom: 8px; }
  .hero-sw h1 { color: #fff; font-size: 32px; margin: 0 0 8px; }
  .tagline { color: #DAE5F0; font-size: 15px; max-width: 720px; }
  .chips { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .chip { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.12); color: #EAF2FA; }
  .chip.gold { background: var(--gold); color: #14212E; }

  .section { padding: 44px 0; }
  .section h2 { font-size: 24px; color: var(--navy-800); margin: 32px 0 16px; }
  .section h2:first-child { margin-top: 0; }
  .overview { font-size: 15.5px; line-height: 1.8; color: var(--slate); max-width: 900px; }

  .grid-3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .feat-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; border-left: 4px solid var(--blue); font-size: 14.5px; font-weight: 600; color: var(--navy-800); }

  .cta-row { display: flex; gap: 12px; margin: 32px 0; }
  .cta { display: inline-block; padding: 12px 26px; border-radius: var(--radius); font-weight: 700; font-size: 14px; text-decoration: none; background: var(--blue); color: #fff; }
  .cta.secondary { background: #fff; color: var(--blue); border: 1.5px solid var(--blue); }

  .rel-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; color: inherit; }
  .rel-card:hover { border-color: var(--blue); }
  .rel-card b { font-size: 14px; display: block; }
  .rel-card p { font-size: 12.5px; color: var(--slate); margin: 6px 0 0; }
</style>
