---
// BaseLayout.astro — shared shell for all Simal pages.
// VISUAL CONTRACT: this chrome is the prototype's "Navy & Gold Executive" layer
// (Prototype/assets/js/chrome.js + assets/css/styles.css) ported 1:1 — announcement
// bar → navy utility strip → logo/search/RFQ-pill row → navy mega nav; footer is the
// 4-band f2 stack. Hrefs remapped to production routes; data (brand chips) from PG.
interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ar';
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  is404?: boolean;
  schemas?: any[];
}


import '../styles/tokens.css';
import '../styles/prototype.css';
import { db } from '../lib/db';

const PORTAL = 'https://kyc.simalme.com';
/* rm(8.4-1): GA4 measurement ID from the build env (apps/site/.env locally,
 * CI/deploy env in pipelines). Unset = GA4 fully disabled: no meta, no load. */
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const brandRows = await db`SELECT slug, name FROM brands WHERE slug != 'other' ORDER BY name`;
const brands = brandRows.map((b: { name: string }) => b.name);
const productCount = await db`SELECT count(*)::int AS n FROM products`;
const nowEpoch = Date.now();
const [announcement] = await db`
  SELECT text, cta_href, cta_label 
  FROM announcements 
  WHERE active = true 
    AND (starts_at IS NULL OR starts_at <= ${nowEpoch})
    AND (ends_at IS NULL OR ends_at >= ${nowEpoch})
  ORDER BY id DESC 
  LIMIT 1
`;

/* rm(4.1): site chrome (nav labels + utility contacts, footer, newsletter) is CMS data —
 * content_blocks site/nav-menus, site/footer, site/newsletter. Fallbacks below equal the
 * pre-4.1 hardcoded literals, so an unseeded DB renders pixel-identically. */
const chromeRows = await db`SELECT entity_id, payload FROM content_blocks WHERE entity = 'site' AND entity_id IN ('nav-menus','footer','newsletter','seo-defaults','counters','awards') AND lang = 'en'`;
const chromeBlock = (id: string) => chromeRows.find((r: any) => r.entity_id === id)?.payload;
const DEFAULT_NAV = { utility: { phone: '+971 4 393 0507', phoneHref: 'tel:+97143930507', email: 'info@simalme.com', hours: '🕘 Sun–Thu 9:00–18:00 GST', portalLabel: '🛡 KYC Portal — Sign in' }, menus: [{ id: 'home', label: 'Home' }, { id: 'products', label: 'Products & Brands' }, { id: 'brands', label: 'Brands' }, { id: 'software', label: 'Software Services' }, { id: 'solutions', label: 'IT Solutions' }, { id: 'partners', label: 'Partners' }, { id: 'insights', label: 'Insights' }, { id: 'about', label: 'About' }] };
const DEFAULT_NEWSLETTER = { heading: 'Stay ahead of the Middle East IT channel', blurb: 'Monthly stock drops, vendor promotions & UAE e-invoicing updates. No spam — unsubscribe anytime.', buttonLabel: 'Subscribe', placeholder: 'Work email address' };
const navData: any = { ...DEFAULT_NAV, ...(chromeBlock('nav-menus') || {}) };
const utility: any = { ...DEFAULT_NAV.utility, ...(navData.utility || {}) };
const menuLabel = (id: string) => (navData.menus || []).find((m: any) => m.id === id)?.label || (DEFAULT_NAV.menus.find((m: any) => m.id === id) || {}).label || id;
const newsletter: any = { ...DEFAULT_NEWSLETTER, ...(chromeBlock('newsletter') || {}) };
const footerData: any = chromeBlock('footer') || null; // structured columns + addresses; null = hardcoded default rendering
/* rm(4.2): SEO defaults + single-source counters + awards (feeds PUB-8: one value per fact) */
const seoDefaults: any = { title: 'Simal Technologies ME — IT Distribution & Software Services, Dubai', description: 'Premier IT distributor & enterprise software partner across UAE, GCC, Africa & Central Asia. Authorized lines for Crucial, Hikvision, TeamGroup, UGREEN, and bespoke enterprise ERP solutions.', ogImage: '/assets/img/brand/simal-logo-360w.png', ...(chromeBlock('seo-defaults') || {}) };
const brandCountLive = brandRows.length; // live brands table (single source of truth per GOV a2: 22)
const DEFAULT_COUNTERS = { brands: 22, skus: 78, years: 24, since: 2002 };
const counters: any = { ...DEFAULT_COUNTERS, ...(chromeBlock('counters') || {}) };
const awards: any[] = Array.isArray(chromeBlock('awards')) ? chromeBlock('awards') : [{ year: '2025', title: 'Hikvision — Best Distributor Partner', issuer: 'Hikvision' }, { year: '2025', title: 'TeamGroup — Best Partner 2025', issuer: 'TeamGroup' }];
/* rm(6.1-2/9.1-1, PUB-8): the About menu's awards line comes from site/awards too (it said
 * "HIKSEMi · TEAMGROUP 2025" while both award walls say Hikvision / TeamGroup). Escaped:
 * mi() output goes through set:html. */
const escText = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
const awardsSummary = escText([...new Set(awards.map((a: any) => a.issuer || String(a.title || '').split(' — ')[0]))].join(' · ')
  + ' ' + [...new Set(awards.map((a: any) => a.year))].join('/'));

const {
  title = seoDefaults.title,
  description = seoDefaults.description,
  lang: propLang,
  dir: propDir,
  canonical: propCanonical,
  ogType = 'website',
  ogImage = 'https://simalme.com/assets/img/brand/simal-logo-1200w.png',
  is404 = false,
  schemas = []
} = Astro.props;

// URL sanitizer rejecting dangerous pseudo-protocols (SEC-13 / P8-4)
const safeHref = (href?: string) => {
  if (!href) return '#';
  const clean = String(href).trim();
  if (/^(?:javascript|data|vbscript):/i.test(clean)) return '#';
  return clean;
};

// Dynamic category counts from DB
const catRows = await db`SELECT cat, count(*)::int AS count FROM products GROUP BY cat`;
const catCounts: Record<string, number> = {};
for (const r of catRows as any[]) {
  catCounts[r.cat] = r.count;
}

// Dynamic top 11 brands with counts for the dedicated Brands dropdown
const topBrandsQuery = await db`
  SELECT b.slug, b.name, count(p.slug)::int AS count
  FROM brands b
  LEFT JOIN products p ON p.brand = b.slug
  WHERE b.slug != 'other'
  GROUP BY b.slug, b.name
  ORDER BY count DESC, b.name ASC
  LIMIT 11
`;

const BRAND_INFO: Record<string, string> = {
  crucial: 'Fuel Your System Performance.',
  ugreen: 'Redefining Connectivity.',
  honeywell: 'Protected Power. Trusted Globally.',
  aiwa: 'Clarity. Performance. Brilliance.',
  arktek: 'Powering Every Pixel.',
  koorui: 'Your Game. Your Vision.',
  toshiba: 'Committed to People, Committed to the Future.',
  teamgroup: 'Memory of Lifetime.',
  nearity: 'Transform Your Meetings.',
  sandisk: 'Capture. Store. Trust.',
  hp: 'Innovation That Inspires.',
  dell: 'Powering Business. Engineered for Reliability.',
  hiksemi: 'Intelligent Storage. Enterprise Trust.',
  hikvision: 'Intelligent Storage. Enterprise Trust.',
  samsung: 'World’s #1 Flash Memory.',
  kingston: 'Memory Made Reliable.',
  wd: 'Powering the World’s Data Infrastructure.',
  msi: 'True Gaming. True Quality.',
  zotac: 'Push the Limit.',
  pny: 'Performance Without Compromise.',
  lenovo: 'World’s #1 PC. Smart Innovation.'
};

const pathname = Astro.url.pathname;
const isArabic = propLang === 'ar' || pathname.startsWith('/ar');
const lang = propLang || (isArabic ? 'ar' : 'en');
const dir = propDir || (isArabic ? 'rtl' : 'ltr');

// Canonical and reciprocal paths (trailing slash normalization)
let cleanPath = pathname;
if (!cleanPath.endsWith('/') && !cleanPath.includes('.')) {
  cleanPath += '/';
}

const exactTwinRoots = [
  '/',
  '/products/',
  '/solutions/',
  '/software/',
  '/about/',
  '/contact/',
  '/rfq/',
  '/onboarding/',
  '/insights/',
  '/legal/',
];

const normPath = cleanPath.startsWith('/ar/') ? (cleanPath.replace(/^\/ar/, '') || '/') : cleanPath;
const isLegalDetail = normPath.startsWith('/legal/') && normPath !== '/legal/';
const hasArTwin = exactTwinRoots.includes(normPath) || isLegalDetail;

let enPath = cleanPath;
let arPath = cleanPath;

if (isArabic) {
  enPath = cleanPath.replace(/^\/ar(\/|$)/, '/') || '/';
  if (!enPath.endsWith('/') && !enPath.includes('.')) enPath += '/';
  arPath = cleanPath;
} else {
  enPath = cleanPath;
  if (hasArTwin) {
    arPath = cleanPath === '/' ? '/ar/' : '/ar' + cleanPath;
  } else if (cleanPath.startsWith('/products/') || cleanPath.startsWith('/brands/') || cleanPath.startsWith('/compare/')) {
    arPath = '/ar/products/';
  } else if (cleanPath.startsWith('/solutions/')) {
    arPath = '/ar/solutions/';
  } else if (cleanPath.startsWith('/software/')) {
    arPath = '/ar/software/';
  } else if (cleanPath.startsWith('/insights/')) {
    arPath = '/ar/insights/';
  } else if (cleanPath.startsWith('/about/') || cleanPath.startsWith('/careers/') || cleanPath.startsWith('/resources/')) {
    arPath = '/ar/about/';
  } else {
    arPath = '/ar/';
  }
}

const canonicalUrl = propCanonical || `https://simalme.com${cleanPath}`;
const enUrl = `https://simalme.com${enPath}`;
const arUrl = `https://simalme.com${arPath}`;

// JSON-LD Baseline Schemas (SEO-4)
const baselineSchemas = [
  {
    '@type': 'Organization',
    '@id': 'https://simalme.com/#organization',
    'name': 'Simal Technologies Middle East LLC',
    'legalName': 'Simal Technologies Middle East LLC',
    'url': 'https://simalme.com/',
    'logo': 'https://simalme.com/assets/img/brand/simal-logo-360w.png',
    'description': 'Premier IT hardware distributor & enterprise software engineering provider across UAE, GCC, Africa & Central Asia.',
    'foundingDate': '2002',
    'sameAs': [
      'https://www.linkedin.com/company/simal-technologies',
      'https://www.instagram.com/simaltechnologies'
    ],
    'contactPoint': [
      {
        '@type': 'ContactPoint',
        'telephone': '+971-4-393-0507',
        'contactType': 'sales',
        'areaServed': ['AE', 'SA', 'QA', 'OM', 'BH', 'KW'],
        'availableLanguage': ['English', 'Arabic']
      },
      {
        '@type': 'ContactPoint',
        'telephone': '+971-4-393-0507',
        'contactType': 'customer support',
        'email': 'info@simalme.com',
        'availableLanguage': ['English', 'Arabic']
      }
    ]
  },
  {
    '@type': 'WebSite',
    '@id': 'https://simalme.com/#website',
    'url': 'https://simalme.com/',
    'name': 'Simal Technologies Middle East',
    'publisher': { '@id': 'https://simalme.com/#organization' },
    'potentialAction': {
      '@type': 'SearchAction',
      'target': 'https://simalme.com/search/?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@type': 'WholesaleStore',
    '@id': 'https://simalme.com/#dubai-hq',
    'name': 'Simal Technologies Middle East LLC - Dubai HQ',
    'url': 'https://simalme.com/',
    'telephone': '+971-4-393-0507',
    'email': 'info@simalme.com',
    'priceRange': '$$$',
    'image': 'https://simalme.com/assets/img/brand/simal-logo-1200w.png',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': 'Office 201, Dar Al Riffa Bldg, Khalid Bin Al Waleed Rd, Bur Dubai',
      'addressLocality': 'Dubai',
      'addressRegion': 'Dubai',
      'postalCode': '49740',
      'addressCountry': 'AE'
    },
    'geo': {
      '@type': 'GeoCoordinates',
      'latitude': 25.2575,
      'longitude': 55.2974
    },
    'openingHoursSpecification': [
      {
        '@type': 'OpeningHoursSpecification',
        'dayOfWeek': ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
        'opens': '09:00',
        'closes': '18:00'
      }
    ]
  },
  {
    '@type': 'LocalBusiness',
    '@id': 'https://simalme.com/#riyadh-liaison',
    'name': 'Simal Technologies - Riyadh Regional Operations',
    'telephone': '+971-4-393-0507',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': 'King Fahd Road, Al Olaya',
      'addressLocality': 'Riyadh',
      'addressCountry': 'SA'
    }
  },
  {
    '@type': 'LocalBusiness',
    '@id': 'https://simalme.com/#doha-liaison',
    'name': 'Simal Technologies - Doha Regional Operations',
    'telephone': '+971-4-393-0507',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': 'Grand Hamad Street',
      'addressLocality': 'Doha',
      'addressCountry': 'QA'
    }
  }
];

const allSchemas = [...baselineSchemas, ...schemas];

const mi = (icon: string, label: string, href: string, desc: string) =>
  `<a href="${href}"><span class="mi">${icon}</span>${label}<span class="md">${desc}</span></a>`;

const isHome = pathname === '/' || pathname === '' || pathname === '/ar' || pathname === '/ar/';
const isProducts = pathname.includes('/products') || pathname.includes('/compare');
const isBrands = pathname.includes('/brands');
const isSoftware = pathname.includes('/software');
const isSolutions = pathname.includes('/solutions');
const isPartners = pathname.includes('/onboarding') || pathname.includes('/rfq');
const isInsights = pathname.includes('/insights') || pathname.includes('/resources');
const isAbout = pathname.includes('/about') || pathname.includes('/careers') || pathname.includes('/contact');
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {/* rm(6.1-3/9.1-1, PUB-8): the known reference for scripts/ci/facts-consistency.mjs */}
  <meta name="simal:brand-count" content={String(brandCountLive)} />
  <meta name="simal:sku-count" content={String(productCount[0].n)} />
  <meta name="simal:years" content={String(counters.years)} />
  <meta name="simal:since" content={String(counters.since)} />
  <link rel="icon" type="image/png" href="/assets/img/brand/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/img/brand/favicon-96.png" />

  {is404 ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <>
      <link rel="canonical" href={canonicalUrl} />
      <link rel="alternate" hreflang="en" href={enUrl} />
      {hasArTwin && <link rel="alternate" hreflang="ar" href={arUrl} />}
      <link rel="alternate" hreflang="x-default" href={enUrl} />
    </>
  )}

  <!-- Open Graph / Facebook (SEO-6) -->
  <meta property="og:site_name" content={isArabic ? 'سيمال للتقنيات الشرق الأوسط' : 'Simal Technologies Middle East'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={isArabic ? 'ar_AE' : 'en_US'} />
  <meta property="og:locale:alternate" content={isArabic ? 'en_US' : 'ar_AE'} />

  <!-- Twitter Card (SEO-6) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@SimalME" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Content Security Policy Floor (SEC-13 / P8-4). frame-ancestors is header-only
       (dev-edge, nginx, plus X-Frame-Options: DENY): browsers ignore it in a meta
       policy and log a console error on every page (rm 9.1-3 browser sweep). -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://kyc.simalme.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; base-uri 'self'; form-action 'self';" />

  <!-- Fonts: Tajawal is the RTL/Arabic face only ([dir=rtl] stack in
       prototype.css); the LTR body face is the system stack (--font in
       tokens.css). Loading the Tajawal stylesheet on LTR pages made an
       external render-blocking fetch delay first paint (rm 9.1-2: home
       LCP 2711ms vs the 2500ms budget, render delay 2257ms) for zero
       glyphs. Arabic pages keep the full preconnect + stylesheet. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {isArabic && <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet" />}

  {GA4_ID ? <meta name="ga4-id" content={GA4_ID} /> : null}

  <!-- Google Consent Mode v2 (rm(3.3): externalized — CSP can drop script-src 'unsafe-inline') -->
  <script src="/assets/js/consent-defaults.js" defer></script>

  <!-- GA4 loader (rm(8.4-1): external file, NOT a processed script element —
       Astro inlines small processed scripts under assetsInlineLimit, and the
       Phase-3 CSP (script-src 'self') would block an inlined loader. Deferred
       classic scripts run in document order: consent-defaults.js first. -->
  <script src="/assets/js/ga4-loader.js" defer></script>

  <!-- JSON-LD Structured Data Graph (SEO-4) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': allSchemas
  })} />
</head>
<body>
  <a href="#main" class="skip-link">{isArabic ? 'الانتقال إلى المحتوى الرئيسي' : 'Skip to main content'}</a>

  <!-- ===== V2 three-tier header (CDW-class) — ported from Prototype chrome.js ===== -->
  <header class="v2hdr" id="v2hdr">
    {announcement && (
      <div class="annbar" id="annbar" role="region" aria-label={isArabic ? 'شريط الإعلانات' : 'Announcement banner'}>
        <div class="wrap">
          <span>{announcement.text}</span>
          {announcement.cta_href && (
            <a href={safeHref(announcement.cta_href)} aria-label={announcement.cta_label || (isArabic ? 'عرض تفاصيل الإعلان' : 'View announced product and request channel pricing')}>
              {announcement.cta_label || (isArabic ? 'شاهد المنتج واطلب عرض السعر ←' : 'See the SKU & RFQ channel pricing →')}
            </a>
          )}
          <button class="x" id="annx" title={isArabic ? 'إغلاق الإعلان' : 'Dismiss'} aria-label={isArabic ? 'إغلاق الإعلان' : 'Dismiss announcement'}>✕</button>
        </div>
      </div>
    )}

    <div class="u2"><div class="wrap">
      <div class="l">
        <a href={utility.phoneHref} style="color:inherit;text-decoration:none"><span>☎ {utility.phone}</span></a><span class="sep">·</span>
        <a href={'mailto:' + utility.email} style="color:inherit;text-decoration:none"><span>✉ {utility.email}</span></a><span class="sep">·</span>
        <span>{isArabic ? '🕘 الأحد–الخميس 9:00–18:00 بتوقيت الإمارات' : utility.hours}</span>
      </div>
      <div class="r">
        <a class="kycl" href={`${PORTAL}/login.html`}>{isArabic ? '🛡 بوابة KYC — تسجيل الدخول' : utility.portalLabel}</a>
        <span class="lng">
          {isArabic ? (
            <><a href={enPath} lang="en" hreflang="en" style="color:inherit;text-decoration:none">EN</a><b>العربية</b></>
          ) : (
            <><b>EN</b><a href={arPath} lang="ar" hreflang="ar" style="color:inherit;text-decoration:none">العربية</a></>
          )}
        </span>
        <span class="soc">
          <a href="https://www.linkedin.com/company/simal-technologies" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true" style="display:inline-block;vertical-align:middle"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2Z"/></svg></a>
          <a href="https://www.instagram.com/simaltechnologies" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram"><span aria-hidden="true">◉</span></a>
          <a href="https://wa.me/971508487861" target="_blank" rel="noopener noreferrer" title="WhatsApp" aria-label="WhatsApp"><span aria-hidden="true">✆</span></a>
        </span>
      </div>
    </div></div>

    <div class="h2main"><div class="wrap">
      <a class="logo" href={isArabic ? '/ar/' : '/'} style="gap:0;margin-right:10px" aria-label={isArabic ? 'سيمال للتقنيات الشرق الأوسط - الرئيسية' : 'Simal Technologies Middle East Home'}>
        <img src="/assets/img/brand/simal-logo-360w.png" alt={isArabic ? 'سيمال للتقنيات الشرق الأوسط' : 'Simal Technologies Middle East'} style="height:42px;width:auto;display:block">
      </a>
      <label class="search2" aria-label={isArabic ? 'البحث في الموقع' : 'Site search'}>🔍
        <input id="hdr-q" type="search" placeholder={isArabic ? `ابحث في ${productCount[0].n} منتجاً، علامة، حلاً…` : `Search ${productCount[0].n} SKUs, brands, solutions…`} aria-label={isArabic ? 'البحث في كتالوج المنتجات والعلامات' : 'Search catalog SKUs, brands, solutions'} autocomplete="off">
        <b id="qb">{isArabic ? 'بحث' : 'Search'}</b>
      </label>
      <div class="sp"></div>
      <a href={`${PORTAL}/login.html`} class="btn btn-o btn-sm">{isArabic ? 'تسجيل الدخول ◁' : '▷ Sign in'}</a>
      <a href={isArabic ? '/ar/rfq/' : '/rfq/'} class="rfq-pill" title={isArabic ? 'سلة طلبات الأسعار' : 'RFQ quote basket'}><span aria-hidden="true">🧾 </span>{isArabic ? 'طلب سعر' : 'RFQ'} <span class="cnt" id="rfqCount">0</span></a>
      <a href={isArabic ? '/ar/onboarding/' : '/onboarding/'} class="btn btn-gold">{isArabic ? 'كن شريكاً' : 'Become a Partner'}</a>
    </div></div>

    <nav class="h2nav" aria-label={isArabic ? 'التنقل الرئيسي' : 'Main navigation'}><div class="wrap">
      <!-- 1. Home -->
      <div class={`ni ${isHome ? 'on' : ''}`} tabindex="0" role="button" aria-haspopup="true" aria-expanded="false" aria-label={isArabic ? 'قائمة الرئيسية' : 'Home menu'}>
