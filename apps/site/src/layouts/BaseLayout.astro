<script>
  /* Global Toast System (accessible notification toasts, zero localStorage) */
  (window as any).showToast = (msg: string, kind?: 'info' | 'err' | 'ok') => {
    const t = document.createElement('div');
    t.className = 'toast' + (kind === 'err' ? ' toast-err' : '');
    t.textContent = msg;
    t.setAttribute('role', 'status');
    t.setAttribute('aria-live', 'polite');
    document.body.appendChild(t);
    setTimeout(() => t.classList.add('in'), 10);
    setTimeout(() => {
      t.classList.remove('in');
      setTimeout(() => t.remove(), 300);
    }, 2600);
  };

  /* Chrome island — RFQ pill count, search submit, announcement dismiss */
  const rfqCount = document.getElementById('rfqCount');
  if (rfqCount) fetch('/api/rfq-basket').then(r => r.json()).then(j => {
    rfqCount.textContent = String(j?.totalQty ?? 0);
  }).catch(() => {});

  const q = (document.getElementById('hdr-q') || document.getElementById('q')) as HTMLInputElement | null;
  const goSearch = () => { if (q && q.value.trim()) location.href = '/search/?q=' + encodeURIComponent(q.value.trim()); };
  document.getElementById('qb')?.addEventListener('click', goSearch);
  q?.addEventListener('keydown', (e) => { if (e.key === 'Enter') goSearch(); });

  /* '/' keyboard shortcut: focuses search box unless typing elsewhere */
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !/input|textarea|select/i.test((e.target as HTMLElement)?.tagName || '')) {
      e.preventDefault();
      if (q) { q.focus(); q.select(); }
    }
  });

  const annbar = document.getElementById('annbar');
  /* ADR-2 (zero localStorage): dismiss preference is a cookie */
  if (document.cookie.split('; ').some(c => c === 'simal_ann=1') && annbar) annbar.remove();
  document.getElementById('annx')?.addEventListener('click', () => {
    document.cookie = 'simal_ann=1; max-age=15552000; path=/';
    annbar?.remove();
    (window as any).showToast?.('Announcement dismissed');
  });

  const hdr = document.getElementById('v2hdr');
  if (hdr) window.addEventListener('scroll', () => {
    hdr.classList.toggle('mini', window.scrollY > 220);
  }, { passive: true });

  /* Viewport-aware mega menu positioning */
  function alignMegas() {
    const vw = document.documentElement.clientWidth;
    document.querySelectorAll<HTMLElement>('.h2nav .ni').forEach(it => {
      const mg = it.querySelector<HTMLElement>('.mega');
      if (!mg) return;
      mg.style.left = '';
      const keep = mg.style.display, keepV = mg.style.visibility;
      mg.style.visibility = 'hidden';
      if (getComputedStyle(mg).display === 'none') mg.style.display = 'grid';
      const r = it.getBoundingClientRect();
      const w = mg.offsetWidth || 880;
      mg.style.display = keep; mg.style.visibility = keepV;
      const absLeft = Math.max(10, Math.min(r.left, vw - w - 10));
      mg.style.left = Math.round(absLeft - r.left) + 'px';
    });
  }
  alignMegas();
  window.addEventListener('resize', alignMegas);

  /* Dropdown open/close state machine & keyboard accessibility */
  const items = Array.from(document.querySelectorAll<HTMLElement>('.h2nav .ni[tabindex]'));
  const closeAll = (except?: HTMLElement) => {
    items.forEach(it => {
      if (it !== except) {
        it.classList.remove('open');
        it.setAttribute('aria-expanded', 'false');
      }
    });
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const activeNi = document.querySelector<HTMLElement>('.h2nav .ni.open');
      closeAll();
      activeNi?.focus();
    }
  });

  items.forEach(ni => {
    ni.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.mega')) return;
      const wasOpen = ni.classList.contains('open');
      closeAll();
      if (!wasOpen) {
        ni.classList.add('open');
        ni.setAttribute('aria-expanded', 'true');
      }
      e.preventDefault();
    });
    ni.addEventListener('mouseenter', () => {
      closeAll(ni);
      ni.classList.add('open');
      ni.setAttribute('aria-expanded', 'true');
    });
    ni.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
        if ((e.target as HTMLElement).closest('.mega')) return;
        e.preventDefault();
        const wasOpen = ni.classList.contains('open');
        closeAll();
        if (!wasOpen) {
          ni.classList.add('open');
          ni.setAttribute('aria-expanded', 'true');
          if (e.key === 'ArrowDown') {
            const firstLink = ni.querySelector<HTMLAnchorElement>('.mega a');
            firstLink?.focus();
          }
        }
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.v2hdr')) closeAll();
  });

  const navBar = document.querySelector('.h2nav');
  navBar?.addEventListener('mouseleave', () => closeAll());

  /* newsletter → routed contact inbox */
  const nlbtn = document.getElementById('nlbtn');
  nlbtn?.addEventListener('click', async () => {
    const mail = (document.getElementById('nlmail') as HTMLInputElement).value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) {
      nlbtn.textContent = 'Enter a valid email';
      (window as any).showToast?.('Enter a valid work email', 'err');
      return;
    }
    nlbtn.textContent = 'Subscribing…';
    try {
      const r = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: 'Newsletter subscriber', email: mail, topic: 'Newsletter', message: 'Newsletter signup from the website footer.' })
      });
      if (r.ok) {
        nlbtn.textContent = 'Subscribed ✓';
        (window as any).showToast?.('Subscribed to channel updates ✓');
        (document.getElementById('nlmail') as HTMLInputElement).value = '';
      } else {
        nlbtn.textContent = 'Failed — email info@simalme.com';
        (window as any).showToast?.('Failed — email info@simalme.com', 'err');
      }
    } catch {
      nlbtn.textContent = 'Network error';
      (window as any).showToast?.('Network error', 'err');
    }
    setTimeout(() => { nlbtn.textContent = 'Subscribe'; }, 4000);
  });

  /* Cookie Consent Manager (UAE PDPL & Google Consent Mode v2) */
  const CONSENT_COOKIE_NAME = 'simal_consent';
  const POLICY_VERSION = '2026-10-12';

  function getConsent() {
    try {
      const match = document.cookie.match(new RegExp('(?:^|; )' + CONSENT_COOKIE_NAME + '=([^;]*)'));
      if (match) return JSON.parse(decodeURIComponent(match[1]));
    } catch (e) {}
    return null;
  }

  function setConsent(analytics: boolean, marketing: boolean) {
    const prevConsent = getConsent();
    const payload = {
      v: POLICY_VERSION,
      ts: Date.now(),
      categories: {
        necessary: true,
        analytics: Boolean(analytics),
        marketing: Boolean(marketing)
      }
    };
    document.cookie = `${CONSENT_COOKIE_NAME}=${encodeURIComponent(JSON.stringify(payload))}; path=/; max-age=31536000; SameSite=Lax`;
    
    // Update Google Consent Mode v2
    const grants = {
      'analytics_storage': analytics ? 'granted' : 'denied',
      'ad_storage': marketing ? 'granted' : 'denied',
      'ad_user_data': marketing ? 'granted' : 'denied',
      'ad_personalization': marketing ? 'granted' : 'denied'
    };
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', grants);
    }

    /* rm(8.4-2): notify the GA4 loader. Grants are mirrored on window so any
     * later reader sees the same state consent-defaults.js would compute. */
    (window as any).__simalConsentGrants = grants;
    window.dispatchEvent(new CustomEvent('simal:consent-accepted', { detail: grants }));

    /* rm(8.4-2): withdrawal of a previously granted analytics consent while
     * GA4 is live in this page — removing the <script> node does not stop an
     * already-running gtag.js, so disable it and reload into the denied
     * state (consent-defaults.js then keeps GA4 off from the first byte). */
    if (!analytics && prevConsent?.categories?.analytics && document.getElementById('ga4-src')) {
      const ga4Id = document.querySelector('meta[name="ga4-id"]')?.getAttribute('content');
      if (ga4Id) (window as any)['ga-disable-' + ga4Id] = true;
      hideBanner();
      hideModal();
      location.reload();
      return;
    }

    hideBanner();
    hideModal();
  }

  const banner = document.getElementById('cookie-banner');
  const backdrop = document.getElementById('cookie-backdrop');
  const modal = document.getElementById('cookie-modal');
  const openBtn = document.getElementById('open-cookie-settings');
  const acceptAllBtn = document.getElementById('cookie-accept-all');
  const rejectAllBtn = document.getElementById('cookie-reject-all');
  const customizeBtn = document.getElementById('cookie-customize');
  const modalCloseBtn = document.getElementById('cookie-modal-close');
  const savePrefsBtn = document.getElementById('cookie-save-prefs');
  const analyticsInput = document.getElementById('consent-analytics') as HTMLInputElement | null;
  const marketingInput = document.getElementById('consent-marketing') as HTMLInputElement | null;

  function showBanner() {
    if (banner) banner.style.display = 'block';
  }
  function hideBanner() {
    if (banner) banner.style.display = 'none';
  }
  function showModal() {
    const c = getConsent();
    if (analyticsInput) analyticsInput.checked = Boolean(c?.categories?.analytics);
    if (marketingInput) marketingInput.checked = Boolean(c?.categories?.marketing);
    if (backdrop) backdrop.style.display = 'block';
    if (modal) modal.style.display = 'block';
    modalCloseBtn?.focus();
  }
  function hideModal() {
    if (backdrop) backdrop.style.display = 'none';
    if (modal) modal.style.display = 'none';
  }

  // Check consent state on initial load. The banner is server-rendered visible, so a
  // recorded choice must hide it explicitly (rm 9.1-3 browser sweep: it reappeared on
  // every page after Accept/Reject). A consent from an older policy version re-prompts.
  const consent = getConsent();
  if (!consent || consent.v !== POLICY_VERSION) {
    showBanner();
  } else {
    hideBanner();
  }

  acceptAllBtn?.addEventListener('click', () => {
    setConsent(true, true);
    (window as any).showToast?.('Cookie consent preferences saved ✓', 'ok');
  });

  rejectAllBtn?.addEventListener('click', () => {
    setConsent(false, false);
    (window as any).showToast?.('Non-essential cookies rejected', 'info');
  });

  customizeBtn?.addEventListener('click', showModal);
  openBtn?.addEventListener('click', showModal);
  modalCloseBtn?.addEventListener('click', hideModal);
  backdrop?.addEventListener('click', hideModal);

  savePrefsBtn?.addEventListener('click', () => {
    setConsent(Boolean(analyticsInput?.checked), Boolean(marketingInput?.checked));
    (window as any).showToast?.('Cookie preferences updated ✓', 'ok');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.style.display === 'block') {
      hideModal();
      openBtn?.focus();
    }
  });
</script>

