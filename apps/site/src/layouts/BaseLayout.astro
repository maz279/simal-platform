  }
  @media (max-width: 860px) {
    .u2 .l > span:last-child, .u2 .l .sep:last-of-type, .u2 .soc { display: none !important; }
  }
  /* phones: the utility strip drops email/hours/lang/socials — phone + portal link only;
   * the 5-column footer and CTA band stack */
  @media (max-width: 620px) {
    .u2 .l a:nth-of-type(n+2), .u2 .l > span, .u2 .sep, .u2 .lng, .u2 .soc { display: none !important; }
    .u2 .r { gap: 10px; }
    .f2-main .wrap { grid-template-columns: 1fr !important; gap: 22px; padding: 32px 20px 24px; }
    .f2-main .wrap > * { min-width: 0; }
    .f2-cta .wrap { padding: 20px; }
    .f2-cta .nl { margin-left: 0; width: 100%; }
    .f2-cta .nl input { width: 100%; min-width: 0; flex: 1; }
    .f2-legal .wrap { flex-direction: column; gap: 6px; }
  }
</style>
