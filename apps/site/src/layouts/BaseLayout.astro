    .h2nav, .search2, .h2main .btn-o, .h2main .btn-gold { display: none !important; }
    .m-nav { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 16px 12px; background: #fff; border-top: 1px solid var(--line); }
    .m-nav a { font-size: 13px; font-weight: 600; color: var(--ink); text-decoration: none; padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; }
