# Simal KYC System — environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env.
# The server also reads process env directly; a .env file is loaded if present.

# Set explicitly per environment; production enables __Host- cookies, the staff-MFA rule and the
# boot refusals listed under "Production requirements" below. Keep comments on their own line
# (an unquoted " #" starts a comment; quote a value that must contain one).
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Comma-separated allowed origins for CORS (same-origin only by default)
CORS_ORIGINS=

# --- Storage ---
DATA_DIR=./data

# --- Sessions (PRD FR-A-001: idle timeout 20 min) ---
SESSION_IDLE_MINUTES=20
SESSION_ABSOLUTE_HOURS=12

# --- Admin bootstrap (REQUIRED on first run; change immediately after first login) ---
# Credentials are read ONLY from the environment — never stored in source.
ADMIN_EMAIL=set-admin-email-here
ADMIN_NAME=Set Admin Name
ADMIN_PASSWORD=set-a-strong-password-here
# MFA for the bootstrap admin: on by default (SEC-04). Set false only for an
# isolated local/dev instance — the admin then signs in with password only.
ADMIN_MFA_REQUIRED=true
# Password policy floor for the bootstrap admin (UI-created users always require 8+).
# NIST 800-63B-4: 15 for single-factor; 8 only with mandatory MFA
ADMIN_PASSWORD_MIN=15
# Base32 TOTP secret (RFC 6238) — only required when ADMIN_MFA_REQUIRED=true.
# IMPORTANT: generate from the base32 alphabet only (A–Z, 2–7). Base64 output
# contains characters outside the base32 alphabet and authenticator apps reject it:
#   node -e "const B='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';let s='';require('crypto').randomBytes(32).forEach(b=>s+=B[b%32]);console.log(s)"
# Then add it to your authenticator app (standard TOTP, 6 digits, 30 s).
ADMIN_TOTP_SECRET=BASE32SECRETPLACEHOLDER

# Env credentials CREATE missing staff accounts only; they never overwrite a password or TOTP
# changed in the console. Set true for ONE restart to re-apply them (audited), then remove.
BOOTSTRAP_RESET_CREDENTIALS=false
# Production refuses staff accounts without TOTP — at boot and on every staff request. false
# accepts password-only staff deliberately (not recommended).
STAFF_MFA_ENFORCED=true

# --- Secondary staff accounts (optional, provisioned only when set; also env-only) ---
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=

# --- Notifications (email + WhatsApp) ---
# SMTP transport: when SMTP_HOST is empty, notifications fall back to the
# local outbox (data/outbox.json) which the admin console can inspect.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Simal KYC Portal <kyc@example.com>"
NOTIFY_SMS_WHATSAPP_API=
NOTIFY_SMS_WHATSAPP_TOKEN=
# Comma separated partner-facing notification switches
NOTIFY_EMAIL_ENABLED=true
NOTIFY_WHATSAPP_ENABLED=true

# Public https origin of this portal — every link inside an email is built from it.
# REQUIRED in production (e.g. https://kyc.simalme.com).
PORTAL_PUBLIC_URL=
# Public https origin of the public site — CMS console links, the console's site probe and its
# CSP connect-src. REQUIRED in production (e.g. https://simalme.com); defaults to the rig edge.
SITE_PUBLIC_URL=

# --- Sanctions / PEP screening ---
# Path to a CSV of watchlist entries: Type,Name,Aliases,Country  (header required).
# Production refuses to start when the file is missing (screening would run on a 5-name starter list).
WATCHLIST_CSV=./data/watchlist.csv
SCREENING_FUZZY_THRESHOLD=0.82

# --- Seller identity on e-invoices ---
# The 15-digit TRN on Simal's FTA certificate (Peppol id = 0235:<first 10 digits>). Production
# refuses to start while the seeded placeholder TRN is in use.
SIMAL_TIN=

# --- Sessions / CSRF ---
# HMAC key for CSRF tokens (32+ random chars). REQUIRED in production; elsewhere a per-process
# random key is used (an open console needs a reload after a restart).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# --- Database pool ---
PG_POOL_MAX=10

# --- Legacy kyc.simalme.com magic links (T2.4) ---
# Signing key of the legacy portal; the exchange is for partner accounts only.
LEGACY_TOKEN_SECRET=

# --- ERP / ASP integration (PRD INT-04/06) ---
# Static API token for counterparty-master pull (generate 32+ random bytes as hex)
MASTER_API_TOKEN=set-a-long-random-token-here
# Webhook push: signed JSON POST on submission.approved etc. (SSRF-guarded)
WEBHOOK_URL=
# rm(9.3-1)/NFR-3: outbound OPS error sink — every 5xx is POSTed here as
# {text, requestId, path, status, message(PDPL-redacted), ts}. Slack/Teams-compatible
# `text` field; NOT Sentry-compatible. Distinct from the ERP WEBHOOK_URL above.
# Rig stand-in: scripts/observability-sink.mjs listens on http://127.0.0.1:8095/hook
OBSERVABILITY_WEBHOOK_URL=
# HMAC secret for the integration boundary: outgoing signed push (INT-08) AND inbound
# /api/integrations/email/bounce verification (rm(2.3-1): sig = hex HMAC-SHA256(secret,
# JSON.stringify(body)) in x-webhook-signature)
WEBHOOK_SECRET=

# Read-only PG role for the SSG build worker (roadmap Task 1.1-2).
# Generate a secret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Create the role:   psql -v build_password=<secret> -f scripts/prod-db-roles.sql
BUILD_DATABASE_URL=postgres://simal_build:CHANGE_ME@127.0.0.1:5433/simal

# AES-256-GCM key for documents at rest (rm(2.4-1)/F-2026-N06). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production REFUSES to boot on the fallback key.
DOC_ENCRYPTION_KEY=

# ClamAV clamd for upload scanning (rm(8.1-1) brings the daemon; scanner fails open to the local
# engine while offline). CLAMAV_HOST is REQUIRED in production.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# rm(5.2): hosting docroot the SSG worker deploys dist/ to after a successful build
# (nginx vhost root / dev-edge SITE_DIST). REQUIRED in production — a missing value is logged as ssg_deploy_missing.
DEPLOY_DIR=

# rm(9.4-1)/NFR-4: comma-separated proxy addresses whose X-Forwarded-For the app
# honors (beyond the implicit 127.0.0.1/::1). Set to the nginx address on staging —
# otherwise EVERY client shares nginx's IP in loginIpLimiter/publicLimiter buckets.
TRUSTED_PROXIES=

# rm(10.3)/GOV a20+a21: ratified lockout and rate-limit tiers.
# 5 consecutive failed logins per account+IP within 10 min -> 15-minute lockout.
LOGIN_FAIL_MAX=5
LOGIN_FAIL_WINDOW_MS=600000
LOGIN_LOCK_MS=900000
# Public forms (RFQ, contact, careers): 5 requests / 10 min per IP; staff/CMS: 300/min.
FORM_RATE_MAX=5
FORM_RATE_WINDOW_MS=600000
STAFF_RATE_MAX=300

# --- Production requirements (NODE_ENV=production refuses to start otherwise) ---
# CSRF_SECRET, DOC_ENCRYPTION_KEY (32 bytes), PORTAL_PUBLIC_URL + SITE_PUBLIC_URL (https), SMTP_HOST (or
# NOTIFY_EMAIL_ENABLED=false), CLAMAV_HOST, DEPLOY_DIR, an existing WATCHLIST_CSV, SIMAL_TIN,
# TOTP on every staff account, and no value left at a placeholder from this file.
