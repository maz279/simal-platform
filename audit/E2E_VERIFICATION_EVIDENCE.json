  "identifiedGapsAndRemediations": [
    {
      "id": "GAP-01",
      "severity": "Medium",
      "area": "SSG Outbox Synchronization",
      "description": "CMS publish enqueued events ('ssg-builder'), but background execution on Windows previously encountered path and shell execution issues.",
      "remediation": "Hardened server.js ssgLoop with NTFS junction-aware siteDir candidate resolution and npm.cmd wrapper. Verified end-to-end: outbox transitioned from queued to processed, static site regenerated in 2.36s.",
      "status": "REMEDIATED_AND_VERIFIED"
    },
    {
      "id": "GAP-02",
      "severity": "Low",
      "area": "Announcement Bar Dynamic Wiring",
      "description": "BaseLayout.astro previously had static promotion text despite existing announcements schema.",
      "remediation": "Added cta_label column to announcements, seeded active record, updated BaseLayout.astro to query SELECT text, cta_href, cta_label FROM announcements, built dedicated Dynamics 365 CMS Studio view (#/announcements) with live banner simulator and rollback.",
      "status": "REMEDIATED_AND_VERIFIED"
    },
    {
      "id": "GAP-03",
      "severity": "Low",
      "area": "Featured Products Array",
      "description": "The 12 featured products strip on index.astro previously referenced static slug literals in the Astro frontmatter.",
      "remediation": "Wired index.astro to query content_blocks WHERE entity = 'site' AND entity_id = 'featured-products' with safe fallback. Controllable from CMS block studio.",
      "status": "REMEDIATED_AND_VERIFIED"
    },
    {
      "id": "GAP-04",
      "severity": "Medium",
      "area": "Testimonials CMS Control & PK Sequence",
      "description": "Testimonials were stored in PostgreSQL but lacked a dedicated CMS studio view, and testimonials_id_seq was out of sync causing duplicate key errors on insert.",
      "remediation": "Executed sync-sequences.mjs, built dedicated Dynamics 365 Testimonials Studio (#/testimonials) with card grid and modal dialog (#modal-testimonial-edit), added CRUD endpoints with revision snapshots and rollback.",
      "status": "REMEDIATED_AND_VERIFIED"
    }
  ]
