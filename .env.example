# Codebase environment — copy to .env and fill values
# Credentials from env only; never commit .env with real values.

# Database
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=simal
PGUSER=simal
SIMAL_PG_PW=

# Portal
PORT=8090
HOST=127.0.0.1
SESSION_IDLE_MINUTES=20
SESSION_ABSOLUTE_HOURS=12

# Bootstrap admin (create on first run only)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_MFA_REQUIRED=false
ADMIN_TOTP_SECRET=

# Staff accounts (optional)
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=

# Integrations
MASTER_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Peppol ASP (INT-5)
ASP_ENDPOINT=
ASP_KEY=
ASP_SECRET=
