{
  "ci": {
    "collect": {
      "staticDistDir": "./apps/site/dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/products/",
        "http://localhost/solutions/",
        "http://localhost/software/",
        "http://localhost/rfq/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "server-response-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}